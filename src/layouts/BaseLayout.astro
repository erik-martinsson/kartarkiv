---
import '../styles/global.css';

const {
  title = 'Erik Martinssons Kartarkiv',
  description = 'Ett publikt arkiv med orienteringskartor, resultat och analyser.'
} = Astro.props;

const base = import.meta.env.BASE_URL;
const cleanBase = base.replace(/\/$/, '');
---

<!doctype html>
<html lang="sv">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />
    <meta name="description" content={description} />
    <title>{title}</title>

    <!-- Open Graph / delningsbild -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="sv_SE" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://kartarkiv.erik-martinsson.se/" />
    <meta property="og:image" content="https://kartarkiv.erik-martinsson.se/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Erik Martinsson Kartarkiv" />

    <!-- X / Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://kartarkiv.erik-martinsson.se/og-image.png" />
  </head>

  <body>
    <header class="site-header">
      <a
        class="brand"
        href={`${cleanBase}/`}
        aria-label="Gå till startsidan"
      >
        <span class="brand-mark">⌁</span>

        <span>
          <strong>ERIK MARTINSSON</strong>
          <small>KARTARKIV</small>
        </span>
      </a>

      <nav aria-label="Huvudmeny">
        <a href={`${cleanBase}/`}>
          Hem
        </a>

        <a href={`${cleanBase}/races/`}>
          Kartarkiv
        </a>

        <a href={`${cleanBase}/statistics/`}>
          Statistik
        </a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      © {new Date().getFullYear()} Erik Martinsson · Byggd med Astro och GitHub Pages
    </footer>
  </body>
</html>