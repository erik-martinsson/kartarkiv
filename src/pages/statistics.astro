      font-variant-numeric: tabular-nums;
      font-weight: 800;
      color: #ff7a00;
      white-space: nowrap;
    }

    .statistics-race-link {
      color: inherit;
      font-weight: 800;
      text-decoration: none;
    }

    .statistics-race-link:hover,
    .statistics-race-link:focus-visible {
      color: #ff7a00;
      text-decoration: underline;
      text-underline-offset: 0.18em;
    }

    .statistics-radar-wrap {
      display: flex;
      justify-content: center;
      width: 100%;
      margin-top: 0.35rem;
    }

    .statistics-radar-chart {
      width: min(100%, 620px);
      height: auto;
      overflow: visible;
    }

    .statistics-radar-grid {
      fill: rgba(255, 255, 255, 0.018);
      stroke: rgba(255, 255, 255, 0.12);
      stroke-width: 1;
    }

    .statistics-radar-axis {
      stroke: rgba(255, 255, 255, 0.12);
      stroke-width: 1;
    }

    .statistics-radar-label {
      fill: rgba(245, 245, 245, 0.86);
      font-size: 15px;
      font-weight: 700;
    }

    .statistics-profile-table-wrap {
      width: min(100%, 920px);
