---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const races = (await getCollection('races')).sort(
  (a, b) => a.data.date.getTime() - b.data.date.getTime()
);

const timeToSeconds = (time) => {
  if (!time) return 0;
  const parts = String(time).split(':').map(Number);
  if (parts.length < 2 || parts.some(Number.isNaN)) return 0;
  return parts.reduce((total, part) => total * 60 + part, 0);
};

const formatDuration = (seconds) => {
  const rounded = Math.max(0, Math.round(seconds));
  const hours = Math.floor(rounded / 3600);
  const minutes = Math.floor((rounded % 3600) / 60);
  const remainingSeconds = rounded % 60;

  if (hours > 0) return `${hours} h ${minutes} min`;
  return `${minutes}:${String(remainingSeconds).padStart(2, '0')}`;
};

const formatCompactDuration = (seconds) => {
  const rounded = Math.max(0, Math.round(seconds));
  const minutes = Math.floor(rounded / 60);
  const remainingSeconds = rounded % 60;
  return `${minutes}:${String(remainingSeconds).padStart(2, '0')}`;
};

const formatNumber = (value, decimals = 0) =>
  value.toLocaleString('sv-SE', {
    minimumFractionDigits: decimals,
    maximumFractionDigits: decimals
  });

const racesWithReliableMistakeData = races.filter(
  (race) =>
    race.data.discipline !== 'Stafett' &&
    Boolean(race.data.winsplits)
);
const reliableMistakeRaceCount = racesWithReliableMistakeData.length;

const totalRaces = races.length;
const totalRaceSeconds = races.reduce((sum, race) => sum + timeToSeconds(race.data.time), 0);
const totalOfficialDistance = races.reduce((sum, race) => sum + (race.data.distanceKm ?? 0), 0);
const totalGpsDistance = races.reduce((sum, race) => sum + (race.data.gpsDistanceKm ?? 0), 0);
const totalControls = races.reduce((sum, race) => sum + (race.data.controls ?? 0), 0);
const totalMistakeSeconds = racesWithReliableMistakeData.reduce((sum, race) => sum + (race.data.mistakeSeconds ?? 0), 0);

const averagePlacement = totalRaces
  ? races.reduce((sum, race) => sum + race.data.position, 0) / totalRaces
  : 0;
const victories = races.filter((race) => race.data.position === 1).length;
const podiums = races.filter((race) => race.data.position <= 3).length;
const podiumShare = totalRaces ? (podiums / totalRaces) * 100 : 0;
const topTen = races.filter((race) => race.data.position <= 10).length;
const topTenShare = totalRaces ? (topTen / totalRaces) * 100 : 0;

const averageMistakeSeconds = reliableMistakeRaceCount ? totalMistakeSeconds / reliableMistakeRaceCount : 0;
const racesWithoutMistakes = racesWithReliableMistakeData.filter((race) => (race.data.mistakeSeconds ?? 0) === 0).length;
const mistakeFreeShare = reliableMistakeRaceCount ? (racesWithoutMistakes / reliableMistakeRaceCount) * 100 : 0;
const largestMistake = racesWithReliableMistakeData.reduce((largest, race) => Math.max(largest, race.data.mistakeSeconds ?? 0), 0);

const racesWithDistance = races.filter(
  (race) => (race.data.distanceKm ?? 0) > 0
);
const longestRace = racesWithDistance.reduce(
  (best, race) =>
    !best || race.data.distanceKm > best.data.distanceKm
      ? race
      : best,
  null
);
const shortestRace = racesWithDistance.reduce(
  (best, race) =>
    !best || race.data.distanceKm < best.data.distanceKm
      ? race
      : best,
  null
);
const mostControlsRace = races.reduce(
  (best, race) =>
    !best || (race.data.controls ?? 0) > (best.data.controls ?? 0)
      ? race
      : best,
  null
);
const mostClimbRace = races.reduce(
  (best, race) =>
    !best || (race.data.gpsClimb ?? 0) > (best.data.gpsClimb ?? 0)
      ? race
      : best,
  null
);
const mostMistakeRace = racesWithReliableMistakeData.reduce(
  (best, race) =>
    !best ||
    (race.data.mistakeSeconds ?? 0) >
      (best.data.mistakeSeconds ?? 0)
      ? race
      : best,
  null
);

const archiveBaseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const raceArchiveUrl = (race) => {
  const id = String(race.id ?? '')
    .replace(/\\/g, '/')
    .replace(/\.md$/i, '')
    .replace(/^\/+|\/+$/g, '');

  return `${archiveBaseUrl}races/${id}/`;
};

const topMistakeRaces = racesWithReliableMistakeData
  .filter((race) => (race.data.mistakeSeconds ?? 0) > 0)
  .sort(
    (a, b) =>
      (b.data.mistakeSeconds ?? 0) -
      (a.data.mistakeSeconds ?? 0)
  )
  .slice(0, 5);
const fastestRace = races
  .map((race) => {
    const seconds = timeToSeconds(race.data.time);
    const distance =
      race.data.gpsDistanceKm ?? race.data.distanceKm ?? 0;

    return {
      race,
      paceSeconds:
        seconds > 0 && distance > 0 ? seconds / distance : Infinity
    };
  })
  .filter((item) => Number.isFinite(item.paceSeconds))
  .sort((a, b) => a.paceSeconds - b.paceSeconds)[0] ?? null;

const yearMap = new Map();
for (const race of races) {
  const year = race.data.date.getFullYear();
  const current = yearMap.get(year) ?? {
    year,
    races: 0,
    distanceKm: 0,
    controls: 0,
    mistakeSeconds: 0,
    raceSeconds: 0
  };
  current.races += 1;
  current.distanceKm += race.data.gpsDistanceKm ?? race.data.distanceKm ?? 0;
  current.controls += race.data.controls ?? 0;
  if (race.data.discipline !== 'Stafett' && race.data.winsplits) {
    current.mistakeSeconds += race.data.mistakeSeconds ?? 0;
  }
  current.raceSeconds += timeToSeconds(race.data.time);
  yearMap.set(year, current);
}

const yearly = [...yearMap.values()].sort((a, b) => a.year - b.year);
const maxRacesPerYear = Math.max(1, ...yearly.map((item) => item.races));
const maxDistancePerYear = Math.max(1, ...yearly.map((item) => item.distanceKm));
const maxControlsPerYear = Math.max(1, ...yearly.map((item) => item.controls));
const yearlyMistakeAverage = yearly.map((item) => ({
  ...item,
  averageMistakeSeconds: item.races ? item.mistakeSeconds / racesWithReliableMistakeData.filter((race)=>race.data.date.getFullYear()===item.year).length || 0 : 0
}));
const maxMistakeAverage = Math.max(1, ...yearlyMistakeAverage.map((item) => item.averageMistakeSeconds));
const yearlyPace = yearly.map((item) => ({
  ...item,
  paceSecondsPerKm: item.distanceKm > 0 ? item.raceSeconds / item.distanceKm : 0
}));

const paceValues = yearlyPace
  .map((item) => item.paceSecondsPerKm)
  .filter((value) => value > 0 && Number.isFinite(value));

const rawMinPace = paceValues.length > 0 ? Math.min(...paceValues) : 0;
const rawMaxPace = paceValues.length > 0 ? Math.max(...paceValues) : 60;
const paceRawStep = Math.max(1, (rawMaxPace - rawMinPace) / 4);
const paceStepOptions = [5, 10, 15, 30, 60, 120];
const paceTickStep =
  paceStepOptions.find((step) => step >= paceRawStep) ??
  Math.ceil(paceRawStep / 60) * 60;
const paceMin = Math.max(0, Math.floor(rawMinPace / paceTickStep) * paceTickStep);
const paceMax = Math.max(
  paceMin + paceTickStep,
  Math.ceil(rawMaxPace / paceTickStep) * paceTickStep
);
const paceRange = Math.max(1, paceMax - paceMin);
const paceYTicks = Array.from(
  { length: Math.round(paceRange / paceTickStep) + 1 },
  (_, index) => paceMin + index * paceTickStep
);


// Genomsnittlig extra löpsträcka per år.
// Endast lopp med både officiell banlängd och GPS-distans räknas.
// Värdet normaliseras mot banlängden så att korta och långa lopp
// kan jämföras rättvist: (GPS - bana) / bana * 100.
const yearlyExtraDistanceMap = new Map();
for (const race of races) {
  const officialDistance = race.data.distanceKm ?? 0;
  const gpsDistance = race.data.gpsDistanceKm ?? 0;

  if (officialDistance <= 0 || gpsDistance <= 0) continue;

  const year = race.data.date.getFullYear();
  const extraPercent =
    ((gpsDistance - officialDistance) / officialDistance) * 100;

  const current = yearlyExtraDistanceMap.get(year) ?? {
    year,
    races: 0,
    extraPercentTotal: 0
  };

  current.races += 1;
  current.extraPercentTotal += extraPercent;
  yearlyExtraDistanceMap.set(year, current);
}

const yearlyExtraDistance = [...yearlyExtraDistanceMap.values()]
  .map((item) => ({
    ...item,
    averageExtraPercent:
      item.races > 0 ? item.extraPercentTotal / item.races : 0
  }))
  .sort((a, b) => a.year - b.year);

const extraDistanceValues = yearlyExtraDistance
  .map((item) => item.averageExtraPercent)
  .filter((value) => Number.isFinite(value));

const rawMinExtraDistance =
  extraDistanceValues.length > 0 ? Math.min(...extraDistanceValues) : 0;
const rawMaxExtraDistance =
  extraDistanceValues.length > 0 ? Math.max(...extraDistanceValues) : 10;

const extraDistancePadding = Math.max(
  1,
  (rawMaxExtraDistance - rawMinExtraDistance) * 0.15
);

const extraDistanceMin = Math.floor(
  (rawMinExtraDistance - extraDistancePadding) / 2
) * 2;
const extraDistanceMax = Math.ceil(
  (rawMaxExtraDistance + extraDistancePadding) / 2
) * 2;
const extraDistanceRange = Math.max(
  1,
  extraDistanceMax - extraDistanceMin
);

const extraDistanceYTicks = [0, 0.25, 0.5, 0.75, 1].map(
  (ratio) => extraDistanceMin + ratio * extraDistanceRange
);

const disciplineMap = new Map();
for (const race of races) {
  const discipline = race.data.discipline?.trim() || 'Okänd';
  disciplineMap.set(discipline, (disciplineMap.get(discipline) ?? 0) + 1);
}

const disciplineStats = [...disciplineMap.entries()]
  .map(([discipline, count]) => ({
    discipline,
    count,
    share: totalRaces ? (count / totalRaces) * 100 : 0
  }))
  .sort((a, b) => b.count - a.count);

const disciplineMistakeMap = new Map();
for (const race of racesWithReliableMistakeData) {
  const discipline = race.data.discipline?.trim() || 'Okänd';
  const current = disciplineMistakeMap.get(discipline) ?? {
    discipline,
    races: 0,
    mistakeSeconds: 0
  };

  current.races += 1;
  current.mistakeSeconds += race.data.mistakeSeconds ?? 0;
  disciplineMistakeMap.set(discipline, current);
}

const disciplineMistakeStats = [...disciplineMistakeMap.values()]
  .map((item) => ({
    ...item,
    totalRaceCount: disciplineMap.get(item.discipline) ?? 0,
    averageMistakeSeconds:
      item.races > 0 ? item.mistakeSeconds / item.races : 0
  }))
  .sort((a, b) => {
    const countDifference = b.totalRaceCount - a.totalRaceCount;

    return countDifference !== 0
      ? countDifference
      : a.discipline.localeCompare(b.discipline, 'sv-SE');
  });

const maxDisciplineMistakeAverage = Math.max(
  1,
  ...disciplineMistakeStats.map((item) => item.averageMistakeSeconds)
);

const pieColors = ['#ff7a00', '#f3b24b', '#dd5f38', '#c44767', '#965b9e', '#5d75b8', '#3f8b9c', '#4f9b78'];

const disciplineColorMap = new Map(
  disciplineStats.map((item, index) => [
    item.discipline,
    pieColors[index % pieColors.length]
  ])
);

let pieCursor = 0;
const pieSegments = disciplineStats.map((item, index) => {
  const start = pieCursor;
  const end = pieCursor + item.share;
  pieCursor = end;
  return `${pieColors[index % pieColors.length]} ${start}% ${end}%`;
});
const pieBackground = pieSegments.length > 0
  ? `conic-gradient(${pieSegments.join(', ')})`
  : 'conic-gradient(#333 0 100%)';

const lineWidth = 900;
const lineHeight = 320;
const linePaddingX = 44;
const linePaddingY = 36;
const usableWidth = lineWidth - linePaddingX * 2;
const usableHeight = lineHeight - linePaddingY * 2;
const linePoints = yearlyMistakeAverage.map((item, index) => {
  const x = yearlyMistakeAverage.length <= 1
    ? lineWidth / 2
    : linePaddingX + (index / (yearlyMistakeAverage.length - 1)) * usableWidth;
  const y = linePaddingY + usableHeight - (item.averageMistakeSeconds / maxMistakeAverage) * usableHeight;
  return { ...item, x, y };
});
const linePath = linePoints.map((point, index) => `${index === 0 ? 'M' : 'L'} ${point.x} ${point.y}`).join(' ');
const pacePoints = yearlyPace.map((item, index) => {
  const x = yearlyPace.length <= 1
    ? lineWidth / 2
    : linePaddingX + (index / (yearlyPace.length - 1)) * usableWidth;
  const y =
    linePaddingY +
    usableHeight -
    ((item.paceSecondsPerKm - paceMin) / paceRange) * usableHeight;
  return { ...item, x, y };
});
const pacePath = pacePoints.map((point, index) => `${index === 0 ? 'M' : 'L'} ${point.x} ${point.y}`).join(' ');

const extraDistancePoints = yearlyExtraDistance.map((item, index) => {
  const x = yearlyExtraDistance.length <= 1
    ? lineWidth / 2
    : linePaddingX + (index / (yearlyExtraDistance.length - 1)) * usableWidth;
  const y =
    linePaddingY +
    usableHeight -
    ((item.averageExtraPercent - extraDistanceMin) / extraDistanceRange) *
      usableHeight;

  return { ...item, x, y };
});

const extraDistancePath = extraDistancePoints
  .map(
    (point, index) =>
      `${index === 0 ? 'M' : 'L'} ${point.x} ${point.y}`
  )
  .join(' ');

const scatterWidth = 900;
const scatterHeight = 360;
const scatterPaddingLeft = 70;
const scatterPaddingRight = 34;
const scatterPaddingTop = 34;
const scatterPaddingBottom = 54;
const scatterUsableWidth =
  scatterWidth - scatterPaddingLeft - scatterPaddingRight;
const scatterUsableHeight =
  scatterHeight - scatterPaddingTop - scatterPaddingBottom;

const scatterRaces = racesWithReliableMistakeData
  .filter(
    (race) =>
      (race.data.distanceKm ?? 0) > 0 &&
      (race.data.mistakeSeconds ?? 0) >= 0
  )
  .map((race) => ({
    title: race.data.title,
    discipline: race.data.discipline?.trim() || 'Okänd',
    distanceKm: race.data.distanceKm ?? 0,
    mistakeSeconds: race.data.mistakeSeconds ?? 0
  }));

const maxScatterDistance = Math.max(
  1,
  ...scatterRaces.map((item) => item.distanceKm)
);
const maxScatterMistake = Math.max(
  60,
  ...scatterRaces.map((item) => item.mistakeSeconds)
);

const scatterPoints = scatterRaces.map((item) => ({
  ...item,
  color:
    disciplineColorMap.get(item.discipline) ??
    '#a0a0a0',
  x:
    scatterPaddingLeft +
    (item.distanceKm / maxScatterDistance) * scatterUsableWidth,
  y:
    scatterPaddingTop +
    scatterUsableHeight -
    (item.mistakeSeconds / maxScatterMistake) * scatterUsableHeight
}));

const scatterXTicks = [0, 0.25, 0.5, 0.75, 1].map((ratio) => ({
  ratio,
  x: scatterPaddingLeft + ratio * scatterUsableWidth,
  value: ratio * maxScatterDistance
}));

const scatterYTicks = [0, 0.25, 0.5, 0.75, 1].map((ratio) => ({
  ratio,
  y: scatterPaddingTop + scatterUsableHeight - ratio * scatterUsableHeight,
  value: ratio * maxScatterMistake
}));


// Resultatnivå över tid.
// Varje lopp räknas om till en resultatpercentil där 100 % = bäst
// i startfältet och 0 % = sist. Diagrammet visar medianen per år
// och disciplin för att minska påverkan från enstaka extremresultat.
const resultPercentileRaces = races
  .filter((race) => {
    const position = race.data.position ?? 0;
    const starters = race.data.starters ?? 0;

    return (
      Number.isFinite(position) &&
      Number.isFinite(starters) &&
      starters >= 2 &&
      position >= 1 &&
      position <= starters
    );
  })
  .map((race) => {
    const position = race.data.position;
    const starters = race.data.starters;
    const percentile =
      ((starters - position) / (starters - 1)) * 100;

    return {
      title: race.data.title,
      discipline: race.data.discipline?.trim() || 'Okänd',
      year: race.data.date.getFullYear(),
      position,
      starters,
      percentile
    };
  });

const median = (values) => {
  const sorted = [...values].sort((a, b) => a - b);
  if (sorted.length === 0) return 0;

  const middle = Math.floor(sorted.length / 2);
  return sorted.length % 2 === 0
    ? (sorted[middle - 1] + sorted[middle]) / 2
    : sorted[middle];
};

const resultYearMin = resultPercentileRaces.length > 0
  ? Math.min(...resultPercentileRaces.map((item) => item.year))
  : new Date().getFullYear();

const resultYearMax = resultPercentileRaces.length > 0
  ? Math.max(...resultPercentileRaces.map((item) => item.year))
  : resultYearMin + 1;

const resultYearRange = Math.max(1, resultYearMax - resultYearMin);

const resultDisciplineYearMap = new Map();
for (const race of resultPercentileRaces) {
  const key = `${race.discipline}::${race.year}`;
  const current = resultDisciplineYearMap.get(key) ?? {
    discipline: race.discipline,
    year: race.year,
    percentiles: []
  };

  current.percentiles.push(race.percentile);
  resultDisciplineYearMap.set(key, current);
}

const resultMedianSeries = [...resultDisciplineYearMap.values()]
  .map((item) => ({
    discipline: item.discipline,
    year: item.year,
    races: item.percentiles.length,
    medianPercentile: median(item.percentiles)
  }))
  .sort((a, b) =>
    a.discipline === b.discipline
      ? a.year - b.year
      : a.discipline.localeCompare(b.discipline, 'sv-SE')
  );

const resultDisciplines = [...new Set(
  resultMedianSeries.map((item) => item.discipline)
)].sort((a, b) => {
  const countA = disciplineMap.get(a) ?? 0;
  const countB = disciplineMap.get(b) ?? 0;
  return countB - countA || a.localeCompare(b, 'sv-SE');
});

const resultBackgroundPoints = resultPercentileRaces.map((item) => ({
  ...item,
  color:
    disciplineColorMap.get(item.discipline) ??
    '#a0a0a0',
  x:
    scatterPaddingLeft +
    ((item.year - resultYearMin) / resultYearRange) *
      scatterUsableWidth,
  y:
    scatterPaddingTop +
    scatterUsableHeight -
    (item.percentile / 100) *
      scatterUsableHeight
}));

const resultMedianPoints = resultMedianSeries.map((item) => ({
  ...item,
  color:
    disciplineColorMap.get(item.discipline) ??
    '#a0a0a0',
  x:
    scatterPaddingLeft +
    ((item.year - resultYearMin) / resultYearRange) *
      scatterUsableWidth,
  y:
    scatterPaddingTop +
    scatterUsableHeight -
    (item.medianPercentile / 100) *
      scatterUsableHeight
}));

const resultMedianLines = resultDisciplines.map((discipline) => {
  const points = resultMedianPoints
    .filter((item) => item.discipline === discipline)
    .sort((a, b) => a.year - b.year);

  return {
    discipline,
    color:
      disciplineColorMap.get(discipline) ??
      '#a0a0a0',
    points,
    path: points
      .map(
        (point, index) =>
          `${index === 0 ? 'M' : 'L'} ${point.x} ${point.y}`
      )
      .join(' ')
  };
});

// Övergripande medianpercentil per år, oavsett disciplin.
const resultOverallYearMap = new Map();
for (const race of resultPercentileRaces) {
  const values = resultOverallYearMap.get(race.year) ?? [];
  values.push(race.percentile);
  resultOverallYearMap.set(race.year, values);
}

const resultOverallMedianPoints = [...resultOverallYearMap.entries()]
  .map(([year, percentiles]) => ({
    year,
    races: percentiles.length,
    medianPercentile: median(percentiles),
    x:
      scatterPaddingLeft +
      ((year - resultYearMin) / resultYearRange) * scatterUsableWidth,
    y:
      scatterPaddingTop +
      scatterUsableHeight -
      (median(percentiles) / 100) * scatterUsableHeight
  }))
  .sort((a, b) => a.year - b.year);

const resultOverallMedianPath = resultOverallMedianPoints
  .map((point, index) => `${index === 0 ? 'M' : 'L'} ${point.x} ${point.y}`)
  .join(' ');

const resultPercentileYTicks = [0, 25, 50, 75, 100].map((value) => ({
  value,
  y:
    scatterPaddingTop +
    scatterUsableHeight -
    (value / 100) *
      scatterUsableHeight
}));

const resultYearTickCount = Math.min(5, resultYearRange + 1);
const resultYearTicks = Array.from(
  { length: resultYearTickCount },
  (_, index) => {
    const ratio =
      resultYearTickCount <= 1
        ? 0
        : index / (resultYearTickCount - 1);
    const year = Math.round(
      resultYearMin + ratio * resultYearRange
    );

    return {
      year,
      x:
        scatterPaddingLeft +
        ((year - resultYearMin) / resultYearRange) *
          scatterUsableWidth
    };
  }
).filter(
  (tick, index, items) =>
    index === 0 || tick.year !== items[index - 1].year
);


// Orienteringsprofil per decennium. Alla axlar normaliseras 0–100 där högre är bättre.
// Jämförelsen använder 2011–2020 och 2021–2030 utan överlappande år.
const profilePeriods = [
  { label: '2011–2020', from: 2011, to: 2020, color: '#f3b24b' },
  { label: '2021–2030', from: 2021, to: 2030, color: '#ff7a00' }
];

const profileEligible = races.filter((race) => {
  const year = race.data.date.getFullYear();
  return year >= 2011 && year <= 2030;
});

const pacePerRace = profileEligible
  .map((race) => {
    const seconds = timeToSeconds(race.data.time);
    const distance = race.data.gpsDistanceKm ?? race.data.distanceKm ?? 0;
    return seconds > 0 && distance > 0 ? seconds / distance : null;
  })
  .filter((value) => value !== null && Number.isFinite(value));

const mistakeSharePerRace = profileEligible
  .filter((race) => race.data.discipline !== 'Stafett' && race.data.winsplits)
  .map((race) => {
    const seconds = timeToSeconds(race.data.time);
    return seconds > 0 ? ((race.data.mistakeSeconds ?? 0) / seconds) * 100 : null;
  })
  .filter((value) => value !== null && Number.isFinite(value));

const extraSharePerRace = profileEligible
  .map((race) => {
    const official = race.data.distanceKm ?? 0;
    const gps = race.data.gpsDistanceKm ?? 0;
    return official > 0 && gps > 0 ? ((gps - official) / official) * 100 : null;
  })
  .filter((value) => value !== null && Number.isFinite(value));

const percentileForRace = (race) => {
  const position = race.data.position ?? 0;
  const starters = race.data.starters ?? 0;
  return starters >= 2 && position >= 1 && position <= starters
    ? ((starters - position) / (starters - 1)) * 100
    : null;
};

const normalizeInverse = (value, allValues) => {
  if (!Number.isFinite(value) || allValues.length === 0) return null;
  const min = Math.min(...allValues);
  const max = Math.max(...allValues);
  if (max <= min) return 100;
  return Math.max(0, Math.min(100, ((max - value) / (max - min)) * 100));
};

const profileSeries = profilePeriods.map((period) => {
  const periodRaces = profileEligible.filter((race) => {
    const year = race.data.date.getFullYear();
    return year >= period.from && year <= period.to;
  });

  const resultValues = periodRaces.map(percentileForRace).filter((v) => v !== null);
  const paceValuesForPeriod = periodRaces.map((race) => {
    const seconds = timeToSeconds(race.data.time);
    const distance = race.data.gpsDistanceKm ?? race.data.distanceKm ?? 0;
    return seconds > 0 && distance > 0 ? seconds / distance : null;
  }).filter((v) => v !== null && Number.isFinite(v));
  const mistakeValues = periodRaces
    .filter((race) => race.data.discipline !== 'Stafett' && race.data.winsplits)
    .map((race) => {
      const seconds = timeToSeconds(race.data.time);
      return seconds > 0 ? ((race.data.mistakeSeconds ?? 0) / seconds) * 100 : null;
    }).filter((v) => v !== null && Number.isFinite(v));
  const extraValues = periodRaces.map((race) => {
    const official = race.data.distanceKm ?? 0;
    const gps = race.data.gpsDistanceKm ?? 0;
    return official > 0 && gps > 0 ? ((gps - official) / official) * 100 : null;
  }).filter((v) => v !== null && Number.isFinite(v));

  const result = resultValues.length ? median(resultValues) : null;
  const paceRaw = paceValuesForPeriod.length ? median(paceValuesForPeriod) : null;
  const mistakeRaw = mistakeValues.length ? median(mistakeValues) : null;
  const extraRaw = extraValues.length ? median(extraValues) : null;

  return {
    ...period,
    races: periodRaces.length,
    resultRaw: result,
    paceRaw,
    mistakeRaw,
    extraRaw,
    values: [
      { label: 'Resultat', value: result },
      { label: 'Fart', value: normalizeInverse(paceRaw, pacePerRace) },
      { label: 'Bomfrihet', value: normalizeInverse(mistakeRaw, mistakeSharePerRace) },
      { label: 'Rakhet', value: normalizeInverse(extraRaw, extraSharePerRace) }
    ]
  };
});

const radarSize = 520;
const radarCenter = radarSize / 2;
const radarRadius = 172;
const radarAxes = ['Resultat', 'Fart', 'Bomfrihet', 'Rakhet'];
const radarPoint = (axisIndex, value) => {
  const angle = -Math.PI / 2 + (axisIndex / radarAxes.length) * Math.PI * 2;
  const radius = radarRadius * (Math.max(0, Math.min(100, value ?? 0)) / 100);
  return {
    x: radarCenter + Math.cos(angle) * radius,
    y: radarCenter + Math.sin(angle) * radius
  };
};
const radarGridLevels = [25, 50, 75, 100].map((level) => ({
  level,
  points: radarAxes.map((_, index) => radarPoint(index, level))
    .map((point) => `${point.x},${point.y}`).join(' ')
}));
const radarAxisPoints = radarAxes.map((label, index) => ({
  label,
  end: radarPoint(index, 100),
  text: radarPoint(index, 116)
}));
const radarProfiles = profileSeries.map((series) => ({
  ...series,
  points: series.values.map((item, index) => radarPoint(index, item.value ?? 0)),
  polygon: series.values.map((item, index) => {
    const point = radarPoint(index, item.value ?? 0);
    return `${point.x},${point.y}`;
  }).join(' ')
}));

