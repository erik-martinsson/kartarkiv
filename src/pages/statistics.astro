      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    .statistics-ranking-table tbody tr:last-child td {
      border-bottom: 0;
    }

    .statistics-ranking-table tbody tr:hover {
      background: rgba(255, 255, 255, 0.025);
    }

    .statistics-ranking-position {
