                        y={tick.y + 4}
                        text-anchor="end"
                        class="statistics-line-year"
                      >
                        {formatCompactDuration(tick.value)}
                      </text>
                    </g>
                  ))}

                  {scatterXTicks.map((tick) => (
                    <g>
                      <line
                        x1={tick.x}
                        x2={tick.x}
                        y1={scatterPaddingTop}
                        y2={scatterHeight - scatterPaddingBottom}
                        class="statistics-grid-line"
                      />
                      <text
                        x={tick.x}
                        y={scatterHeight - 24}
                        text-anchor="middle"
                        class="statistics-line-year"
