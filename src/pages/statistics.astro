          <h3>Resultatnivå över tid</h3>
          <p>Medianpercentil per år och disciplin. Högre är bättre. Den vita linjen visar medianen för alla discipliner tillsammans.</p>
        </div>

        {
          resultMedianPoints.length > 0 ? (
            <>
              <div class="statistics-result-legend" aria-label="Discipliner">
                <span class="statistics-result-legend-item statistics-result-legend-overall">
                  <span class="statistics-result-legend-dot statistics-result-legend-dot-overall" aria-hidden="true"></span>
                  Alla discipliner (median)
                </span>
                {resultDisciplines.map((discipline) => (
                  <span class="statistics-result-legend-item">
                    <span
                      class="statistics-result-legend-dot"
                      style={`background: ${disciplineColorMap.get(discipline) ?? '#a0a0a0'}`}
                      aria-hidden="true"
                    ></span>
                    {discipline}
                  </span>
                ))}
              </div>

              <div class="statistics-line-chart-wrap">
                <svg
                  class="statistics-line-chart"
                  viewBox={`0 0 ${scatterWidth} ${scatterHeight}`}
                  role="img"
                  aria-labelledby="result-percentile-title result-percentile-desc"
                >
                  <title id="result-percentile-title">Resultatnivå över tid</title>
                  <desc id="result-percentile-desc">
                    Färgade linjer visar medianpercentil per år och disciplin. Den tjocka vita linjen visar medianen för alla discipliner tillsammans. Små svaga punkter visar enskilda lopp. Hundra procent är bäst i startfältet och noll procent sist.
                  </desc>

                  {resultPercentileYTicks.map((tick) => (
                    <g>
                      <line
                        x1={scatterPaddingLeft}
                        x2={scatterWidth - scatterPaddingRight}
                        y1={tick.y}
                        y2={tick.y}
                        class="statistics-grid-line"
                      />
                      <text
                        x={scatterPaddingLeft - 10}
                        y={tick.y + 4}
                        text-anchor="end"
                        class="statistics-line-year"
                      >
                        {tick.value} %
                      </text>
                    </g>
                  ))}

                  {resultYearTicks.map((tick) => (
                    <g>
                      <line
                        x1={tick.x}
                        x2={tick.x}
                        y1={scatterPaddingTop}
                        y2={scatterHeight - scatterPaddingBottom}
                        class="statistics-grid-line"
                      />
                      <text
                        x={tick.x}
                        y={scatterHeight - 24}
                        text-anchor="middle"
                        class="statistics-line-year"
                      >
                        {tick.year}
                      </text>
                    </g>
                  ))}

                  <text
                    x={scatterWidth / 2}
                    y={scatterHeight - 5}
                    text-anchor="middle"
                    class="statistics-line-year"
                  >
                    År
                  </text>

                  <text
                    x="14"
                    y={scatterHeight / 2}
                    text-anchor="middle"
                    class="statistics-line-year"
                    transform={`rotate(-90 14 ${scatterHeight / 2})`}
                  >
                    Resultatpercentil
                  </text>

                  {resultBackgroundPoints.map((point) => (
                    <g>
                      <title>
                        {`${point.title} · ${point.year} · ${point.discipline} · ${point.position}/${point.starters} · ${formatNumber(point.percentile, 1)} %`}
                      </title>
                      <circle
                        cx={point.x}
                        cy={point.y}
                        r="2"
                        fill={point.color}
                        fill-opacity="0.16"
                        stroke="none"
                      />
                    </g>
                  ))}

                  {resultMedianLines.map((series) => (
                    <path
                      d={series.path}
                      fill="none"
                      stroke={series.color}
                      stroke-width="3"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  ))}

                  <path
                    d={resultOverallMedianPath}
                    fill="none"
                    stroke="rgba(245, 245, 245, 0.92)"
                    stroke-width="5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />

                  {resultOverallMedianPoints.map((point) => (
                    <g>
                      <title>
                        {`${point.year} · total median ${formatNumber(point.medianPercentile, 1)} % · ${point.races} lopp`}
                      </title>
                      <circle
                        cx={point.x}
                        cy={point.y}
                        r="6"
                        fill="#f5f5f5"
                        stroke="#aeb3b7"
                        stroke-width="2"
                      />
                    </g>
                  ))}

                  {resultMedianPoints.map((point) => (
                    <g>
                      <title>
                        {`${point.discipline} · ${point.year} · median ${formatNumber(point.medianPercentile, 1)} % · ${point.races} lopp`}
                      </title>
                      <circle
                        cx={point.x}
                        cy={point.y}
                        r="5"
                        fill={point.color}
                        stroke="#17191b"
                        stroke-width="2"
                      />
                    </g>
                  ))}
                </svg>
              </div>
            </>
          ) : (
            <p class="statistics-empty-chart">Ingen statistik ännu.</p>
          )
        }
      </article>
    </section>

    <section class="statistics-section">
      <article class="panel statistics-chart-panel statistics-chart-wide">
        <div class="statistics-chart-heading">
          <h3>Orienteringsprofil per decennium</h3>
          <p>Jämförelse mellan 2011–2020 och 2021–2030. Längre ut är bättre på samtliga axlar.</p>
        </div>

        <div class="statistics-result-legend" aria-label="Perioder">
          {radarProfiles.map((series) => (
            <span class="statistics-result-legend-item">
              <span class="statistics-result-legend-dot" style={`background: ${series.color}`} aria-hidden="true"></span>
              {series.label} · {series.races} lopp
            </span>
          ))}
        </div>

        <div class="statistics-radar-wrap">
          <svg class="statistics-radar-chart" viewBox={`0 0 ${radarSize} ${radarSize}`} role="img" aria-labelledby="radar-title radar-desc">
            <title id="radar-title">Orienteringsprofil per decennium</title>
            <desc id="radar-desc">Fyra normaliserade mått jämför resultat, fart, bomfrihet och rakhet mellan perioderna 2011 till 2020 och 2021 till 2030. Högre värde är bättre.</desc>

            {radarGridLevels.map((grid) => (
              <polygon points={grid.points} class="statistics-radar-grid" />
            ))}
            {radarAxisPoints.map((axis) => (
              <g>
                <line x1={radarCenter} y1={radarCenter} x2={axis.end.x} y2={axis.end.y} class="statistics-radar-axis" />
                <text x={axis.text.x} y={axis.text.y} text-anchor="middle" dominant-baseline="middle" class="statistics-radar-label">{axis.label}</text>
              </g>
            ))}

            {radarProfiles.map((series) => (
              <g>
                <polygon points={series.polygon} fill={series.color} fill-opacity="0.14" stroke={series.color} stroke-width="4" stroke-linejoin="round" />
                {series.points.map((point, index) => (
                  <g>
                    <title>{`${series.label} · ${series.values[index].label}: ${series.values[index].value === null ? 'saknar data' : `${formatNumber(series.values[index].value, 0)} / 100`}`}</title>
                    <circle cx={point.x} cy={point.y} r="6" fill={series.color} stroke="#17191b" stroke-width="2" />
                  </g>
                ))}
              </g>
            ))}
          </svg>
        </div>
        <div class="statistics-profile-table-wrap">
          <table class="statistics-profile-table">
            <thead>
              <tr>
                <th scope="col">Mått</th>
                {radarProfiles.map((series) => <th scope="col">{series.label}</th>)}
                <th scope="col">Förändring</th>
              </tr>
            </thead>
            <tbody>
              {[
                { label: 'Resultat', note: 'Median resultatpercentil', key: 'resultRaw', kind: 'percent', better: 'higher' },
                { label: 'Fart', note: 'Median snittfart (min/km)', key: 'paceRaw', kind: 'pace', better: 'lower' },
                { label: 'Bomfrihet', note: 'Bomtid som andel av totaltid', key: 'mistakeRaw', kind: 'percent', better: 'lower' },
                { label: 'Rakhet', note: 'Extra GPS-sträcka som andel', key: 'extraRaw', kind: 'percent', better: 'lower' }
              ].map((metric) => {
                const first = radarProfiles[0]?.[metric.key];
                const second = radarProfiles[1]?.[metric.key];
                const hasBoth = Number.isFinite(first) && Number.isFinite(second);
                const delta = hasBoth ? second - first : null;
                const improved = delta !== null && (metric.better === 'higher' ? delta > 0 : delta < 0);
                const worsened = delta !== null && (metric.better === 'higher' ? delta < 0 : delta > 0);
                const formatMetric = (value) => !Number.isFinite(value)
                  ? '—'
                  : metric.kind === 'pace'
                    ? `${formatCompactDuration(value)} /km`
                    : `${formatNumber(value, 1)} %`;
                const change = delta === null
                  ? '—'
                  : metric.kind === 'pace'
                    ? `${delta > 0 ? '+' : delta < 0 ? '−' : ''}${formatCompactDuration(Math.abs(delta))} /km`
                    : `${delta > 0 ? '+' : ''}${formatNumber(delta, 1)} p.e.`;
                return (
                  <tr>
                    <th scope="row"><strong>{metric.label}</strong><small>{metric.note}</small></th>
                    <td class="statistics-profile-period-a">{formatMetric(first)}</td>
                    <td class="statistics-profile-period-b">{formatMetric(second)}</td>
                    <td class:list={["statistics-profile-change", { "is-improved": improved, "is-worse": worsened }]}>{change}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
        <p class="statistics-radar-note">Spindeldiagrammet visar samma fyra mått som index 0–100 för att göra formerna jämförbara. Tabellen visar de faktiska medianvärdena. Lägre min/km, lägre bomandel och mindre extra GPS-sträcka är bättre.</p>
      </article>
    </section>

    <section class="statistics-section statistics-top-mistakes">
      <div class="statistics-section-heading">
        <div>
          <p class="eyebrow">TOPP 5</p>
          <h2>Störst registrerad bomtid</h2>
        </div>
      </div>

      <div class="panel statistics-ranking-panel">
        {
          topMistakeRaces.length > 0 ? (
            <div class="statistics-table-wrap">
              <table class="statistics-ranking-table">
                <thead>
                  <tr>
                    <th scope="col">#</th>
                    <th scope="col">Lopp</th>
                    <th scope="col">År</th>
                    <th scope="col">Bomtid</th>
                    <th scope="col">Disciplin</th>
                    <th scope="col">Plats</th>
                  </tr>
                </thead>
                <tbody>
                  {topMistakeRaces.map((race, index) => (
                    <tr>
                      <td class="statistics-ranking-position">
                        {index + 1}
                      </td>
                      <td>
                        <a
                          class="statistics-race-link"
                          href={raceArchiveUrl(race)}
                        >
                          {race.data.title}
                        </a>
                      </td>
                      <td>{race.data.date.getFullYear()}</td>
                      <td class="statistics-ranking-mistake">
                        {formatCompactDuration(race.data.mistakeSeconds ?? 0)}
                      </td>
                      <td>{race.data.discipline?.trim() || 'Okänd'}</td>
                      <td>{race.data.location?.trim() || '—'}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          ) : (
            <p class="statistics-empty-chart">
              Ingen registrerad bomtid ännu.
            </p>
          )
        }
      </div>
    </section>

    <p class="statistics-update-note">
      Statistiken uppdateras automatiskt när nya tävlingar publiceras.
    </p>
  </main>

  <style>
    .statistics-result-legend {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.55rem 1rem;
      margin: 0.15rem 0 0.35rem;
      color: var(--muted, #a0a0a0);
      font-size: 0.78rem;
    }

    .statistics-result-legend-item {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
    }

    .statistics-result-legend-dot {
      width: 0.65rem;
      height: 0.65rem;
      border-radius: 999px;
      flex: 0 0 auto;
    }

    .statistics-result-legend-dot-overall {
      background: #f5f5f5;
      box-shadow: 0 0 0 1px rgba(174, 179, 183, 0.85);
    }

    .statistics-result-legend-overall {
      color: rgba(245, 245, 245, 0.92);
      font-weight: 700;
    }

    .statistics-ranking-panel {
      overflow: hidden;
    }

    .statistics-table-wrap {
      width: 100%;
      overflow-x: auto;
    }

    .statistics-ranking-table {
      width: 100%;
      border-collapse: collapse;
      min-width: 720px;
    }

    .statistics-ranking-table th,
    .statistics-ranking-table td {
      padding: 0.9rem 1rem;
      text-align: left;
      border-bottom: 1px solid rgba(255, 255, 255, 0.09);
      vertical-align: middle;
    }

    .statistics-ranking-table th {
      color: var(--muted, #a0a0a0);
      font-size: 0.78rem;
