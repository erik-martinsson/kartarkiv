---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const races = (await getCollection('races')).sort(
  (a, b) => a.data.date.getTime() - b.data.date.getTime()
);

const timeToSeconds = (time) => {
  if (!time) return 0;
  const parts = String(time).split(':').map(Number);
  if (parts.length < 2 || parts.some(Number.isNaN)) return 0;
  return parts.reduce((total, part) => total * 60 + part, 0);
};

const formatDuration = (seconds) => {
  const rounded = Math.max(0, Math.round(seconds));
  const hours = Math.floor(rounded / 3600);
  const minutes = Math.floor((rounded % 3600) / 60);
  const remainingSeconds = rounded % 60;

  if (hours > 0) return `${hours} h ${minutes} min`;
  return `${minutes}:${String(remainingSeconds).padStart(2, '0')}`;
};

const formatCompactDuration = (seconds) => {
  const rounded = Math.max(0, Math.round(seconds));
  const minutes = Math.floor(rounded / 60);
  const remainingSeconds = rounded % 60;
  return `${minutes}:${String(remainingSeconds).padStart(2, '0')}`;
};

const formatNumber = (value, decimals = 0) =>
  value.toLocaleString('sv-SE', {
    minimumFractionDigits: decimals,
    maximumFractionDigits: decimals
  });

const racesWithReliableMistakeData = races.filter(
  (race) =>
    race.data.discipline !== 'Stafett' &&
    Boolean(race.data.winsplits)
);
const reliableMistakeRaceCount = racesWithReliableMistakeData.length;

const totalRaces = races.length;
const totalRaceSeconds = races.reduce((sum, race) => sum + timeToSeconds(race.data.time), 0);
const totalOfficialDistance = races.reduce((sum, race) => sum + (race.data.distanceKm ?? 0), 0);
const totalGpsDistance = races.reduce((sum, race) => sum + (race.data.gpsDistanceKm ?? 0), 0);
const totalControls = races.reduce((sum, race) => sum + (race.data.controls ?? 0), 0);
const totalMistakeSeconds = racesWithReliableMistakeData.reduce((sum, race) => sum + (race.data.mistakeSeconds ?? 0), 0);

const averagePlacement = totalRaces
  ? races.reduce((sum, race) => sum + race.data.position, 0) / totalRaces
  : 0;
const victories = races.filter((race) => race.data.position === 1).length;
const podiums = races.filter((race) => race.data.position <= 3).length;
const podiumShare = totalRaces ? (podiums / totalRaces) * 100 : 0;
const topTen = races.filter((race) => race.data.position <= 10).length;
const topTenShare = totalRaces ? (topTen / totalRaces) * 100 : 0;

const averageMistakeSeconds = reliableMistakeRaceCount ? totalMistakeSeconds / reliableMistakeRaceCount : 0;
const racesWithoutMistakes = racesWithReliableMistakeData.filter((race) => (race.data.mistakeSeconds ?? 0) === 0).length;
const mistakeFreeShare = reliableMistakeRaceCount ? (racesWithoutMistakes / reliableMistakeRaceCount) * 100 : 0;
const largestMistake = racesWithReliableMistakeData.reduce((largest, race) => Math.max(largest, race.data.mistakeSeconds ?? 0), 0);

const racesWithDistance = races.filter(
  (race) => (race.data.distanceKm ?? 0) > 0
);
const longestRace = racesWithDistance.reduce(
  (best, race) =>
    !best || race.data.distanceKm > best.data.distanceKm
      ? race
      : best,
  null
);
const shortestRace = racesWithDistance.reduce(
  (best, race) =>
    !best || race.data.distanceKm < best.data.distanceKm
      ? race
      : best,
  null
);
const mostControlsRace = races.reduce(
  (best, race) =>
    !best || (race.data.controls ?? 0) > (best.data.controls ?? 0)
      ? race
      : best,
  null
);
const mostClimbRace = races.reduce(
  (best, race) =>
    !best || (race.data.gpsClimb ?? 0) > (best.data.gpsClimb ?? 0)
      ? race
      : best,
  null
);
const mostMistakeRace = racesWithReliableMistakeData.reduce(
  (best, race) =>
    !best ||
    (race.data.mistakeSeconds ?? 0) >
      (best.data.mistakeSeconds ?? 0)
      ? race
      : best,
  null
);

const archiveBaseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const raceArchiveUrl = (race) => {
  const id = String(race.id ?? '')
    .replace(/\\/g, '/')
    .replace(/\.md$/i, '')
    .replace(/^\/+|\/+$/g, '');

  return `${archiveBaseUrl}races/${id}/`;
};

const topMistakeRaces = racesWithReliableMistakeData
  .filter((race) => (race.data.mistakeSeconds ?? 0) > 0)
  .sort(
    (a, b) =>
      (b.data.mistakeSeconds ?? 0) -
      (a.data.mistakeSeconds ?? 0)
  )
  .slice(0, 5);
const fastestRace = races
  .map((race) => {
    const seconds = timeToSeconds(race.data.time);
    const distance =
      race.data.gpsDistanceKm ?? race.data.distanceKm ?? 0;

    return {
      race,
      paceSeconds:
        seconds > 0 && distance > 0 ? seconds / distance : Infinity
    };
  })
  .filter((item) => Number.isFinite(item.paceSeconds))
  .sort((a, b) => a.paceSeconds - b.paceSeconds)[0] ?? null;

const yearMap = new Map();
for (const race of races) {
  const year = race.data.date.getFullYear();
  const current = yearMap.get(year) ?? {
    year,
    races: 0,
    distanceKm: 0,
    controls: 0,
    mistakeSeconds: 0,
    raceSeconds: 0
  };
  current.races += 1;
  current.distanceKm += race.data.gpsDistanceKm ?? race.data.distanceKm ?? 0;
  current.controls += race.data.controls ?? 0;
  if (race.data.discipline !== 'Stafett' && race.data.winsplits) {
    current.mistakeSeconds += race.data.mistakeSeconds ?? 0;
  }
  current.raceSeconds += timeToSeconds(race.data.time);
  yearMap.set(year, current);
}

const yearly = [...yearMap.values()].sort((a, b) => a.year - b.year);
const maxRacesPerYear = Math.max(1, ...yearly.map((item) => item.races));
const maxDistancePerYear = Math.max(1, ...yearly.map((item) => item.distanceKm));
const maxControlsPerYear = Math.max(1, ...yearly.map((item) => item.controls));
const yearlyMistakeAverage = yearly.map((item) => ({
  ...item,
  averageMistakeSeconds: item.races ? item.mistakeSeconds / racesWithReliableMistakeData.filter((race)=>race.data.date.getFullYear()===item.year).length || 0 : 0
}));
const maxMistakeAverage = Math.max(1, ...yearlyMistakeAverage.map((item) => item.averageMistakeSeconds));
const yearlyPace = yearly.map((item) => ({
  ...item,
  paceSecondsPerKm: item.distanceKm > 0 ? item.raceSeconds / item.distanceKm : 0
}));

const paceValues = yearlyPace
  .map((item) => item.paceSecondsPerKm)
  .filter((value) => value > 0 && Number.isFinite(value));

const rawMinPace = paceValues.length > 0 ? Math.min(...paceValues) : 0;
const rawMaxPace = paceValues.length > 0 ? Math.max(...paceValues) : 60;
const paceRawStep = Math.max(1, (rawMaxPace - rawMinPace) / 4);
const paceStepOptions = [5, 10, 15, 30, 60, 120];
const paceTickStep =
  paceStepOptions.find((step) => step >= paceRawStep) ??
  Math.ceil(paceRawStep / 60) * 60;
const paceMin = Math.max(0, Math.floor(rawMinPace / paceTickStep) * paceTickStep);
const paceMax = Math.max(
  paceMin + paceTickStep,
  Math.ceil(rawMaxPace / paceTickStep) * paceTickStep
);
const paceRange = Math.max(1, paceMax - paceMin);
const paceYTicks = Array.from(
  { length: Math.round(paceRange / paceTickStep) + 1 },
  (_, index) => paceMin + index * paceTickStep
);


// Genomsnittlig extra löpsträcka per år.
// Endast lopp med både officiell banlängd och GPS-distans räknas.
// Värdet normaliseras mot banlängden så att korta och långa lopp
// kan jämföras rättvist: (GPS - bana) / bana * 100.
const yearlyExtraDistanceMap = new Map();
for (const race of races) {
  const officialDistance = race.data.distanceKm ?? 0;
  const gpsDistance = race.data.gpsDistanceKm ?? 0;

  if (officialDistance <= 0 || gpsDistance <= 0) continue;

  const year = race.data.date.getFullYear();
  const extraPercent =
    ((gpsDistance - officialDistance) / officialDistance) * 100;

  const current = yearlyExtraDistanceMap.get(year) ?? {
    year,
    races: 0,
    extraPercentTotal: 0
  };

  current.races += 1;
  current.extraPercentTotal += extraPercent;
  yearlyExtraDistanceMap.set(year, current);
}

const yearlyExtraDistance = [...yearlyExtraDistanceMap.values()]
  .map((item) => ({
    ...item,
    averageExtraPercent:
      item.races > 0 ? item.extraPercentTotal / item.races : 0
  }))
  .sort((a, b) => a.year - b.year);

const extraDistanceValues = yearlyExtraDistance
  .map((item) => item.averageExtraPercent)
  .filter((value) => Number.isFinite(value));

const rawMinExtraDistance =
  extraDistanceValues.length > 0 ? Math.min(...extraDistanceValues) : 0;
const rawMaxExtraDistance =
  extraDistanceValues.length > 0 ? Math.max(...extraDistanceValues) : 10;

const extraDistancePadding = Math.max(
  1,
  (rawMaxExtraDistance - rawMinExtraDistance) * 0.15
);

const extraDistanceMin = Math.floor(
  (rawMinExtraDistance - extraDistancePadding) / 2
) * 2;
const extraDistanceMax = Math.ceil(
  (rawMaxExtraDistance + extraDistancePadding) / 2
) * 2;
const extraDistanceRange = Math.max(
  1,
  extraDistanceMax - extraDistanceMin
);

const extraDistanceYTicks = [0, 0.25, 0.5, 0.75, 1].map(
  (ratio) => extraDistanceMin + ratio * extraDistanceRange
);

const disciplineMap = new Map();
for (const race of races) {
  const discipline = race.data.discipline?.trim() || 'Okänd';
  disciplineMap.set(discipline, (disciplineMap.get(discipline) ?? 0) + 1);
}

const disciplineStats = [...disciplineMap.entries()]
  .map(([discipline, count]) => ({
    discipline,
    count,
    share: totalRaces ? (count / totalRaces) * 100 : 0
  }))
  .sort((a, b) => b.count - a.count);

const disciplineMistakeMap = new Map();
for (const race of racesWithReliableMistakeData) {
  const discipline = race.data.discipline?.trim() || 'Okänd';
  const current = disciplineMistakeMap.get(discipline) ?? {
    discipline,
    races: 0,
    mistakeSeconds: 0
  };

  current.races += 1;
  current.mistakeSeconds += race.data.mistakeSeconds ?? 0;
  disciplineMistakeMap.set(discipline, current);
}

const disciplineMistakeStats = [...disciplineMistakeMap.values()]
  .map((item) => ({
    ...item,
    totalRaceCount: disciplineMap.get(item.discipline) ?? 0,
    averageMistakeSeconds:
      item.races > 0 ? item.mistakeSeconds / item.races : 0
  }))
  .sort((a, b) => {
    const countDifference = b.totalRaceCount - a.totalRaceCount;

    return countDifference !== 0
      ? countDifference
      : a.discipline.localeCompare(b.discipline, 'sv-SE');
  });

const maxDisciplineMistakeAverage = Math.max(
  1,
  ...disciplineMistakeStats.map((item) => item.averageMistakeSeconds)
);

const pieColors = ['#ff7a00', '#f3b24b', '#dd5f38', '#c44767', '#965b9e', '#5d75b8', '#3f8b9c', '#4f9b78'];

const disciplineColorMap = new Map(
  disciplineStats.map((item, index) => [
    item.discipline,
    pieColors[index % pieColors.length]
  ])
);

let pieCursor = 0;
const pieSegments = disciplineStats.map((item, index) => {
  const start = pieCursor;
  const end = pieCursor + item.share;
  pieCursor = end;
  return `${pieColors[index % pieColors.length]} ${start}% ${end}%`;
});
const pieBackground = pieSegments.length > 0
  ? `conic-gradient(${pieSegments.join(', ')})`
  : 'conic-gradient(#333 0 100%)';

const lineWidth = 900;
const lineHeight = 320;
const linePaddingX = 44;
const linePaddingY = 36;
const usableWidth = lineWidth - linePaddingX * 2;
const usableHeight = lineHeight - linePaddingY * 2;
const linePoints = yearlyMistakeAverage.map((item, index) => {
  const x = yearlyMistakeAverage.length <= 1
    ? lineWidth / 2
    : linePaddingX + (index / (yearlyMistakeAverage.length - 1)) * usableWidth;
  const y = linePaddingY + usableHeight - (item.averageMistakeSeconds / maxMistakeAverage) * usableHeight;
  return { ...item, x, y };
});
const linePath = linePoints.map((point, index) => `${index === 0 ? 'M' : 'L'} ${point.x} ${point.y}`).join(' ');
const pacePoints = yearlyPace.map((item, index) => {
  const x = yearlyPace.length <= 1
    ? lineWidth / 2
    : linePaddingX + (index / (yearlyPace.length - 1)) * usableWidth;
  const y =
    linePaddingY +
    usableHeight -
    ((item.paceSecondsPerKm - paceMin) / paceRange) * usableHeight;
  return { ...item, x, y };
});
const pacePath = pacePoints.map((point, index) => `${index === 0 ? 'M' : 'L'} ${point.x} ${point.y}`).join(' ');

const extraDistancePoints = yearlyExtraDistance.map((item, index) => {
  const x = yearlyExtraDistance.length <= 1
    ? lineWidth / 2
    : linePaddingX + (index / (yearlyExtraDistance.length - 1)) * usableWidth;
  const y =
    linePaddingY +
    usableHeight -
    ((item.averageExtraPercent - extraDistanceMin) / extraDistanceRange) *
      usableHeight;

  return { ...item, x, y };
});

const extraDistancePath = extraDistancePoints
  .map(
    (point, index) =>
      `${index === 0 ? 'M' : 'L'} ${point.x} ${point.y}`
  )
  .join(' ');

const scatterWidth = 900;
const scatterHeight = 360;
const scatterPaddingLeft = 70;
const scatterPaddingRight = 34;
const scatterPaddingTop = 34;
const scatterPaddingBottom = 54;
const scatterUsableWidth =
  scatterWidth - scatterPaddingLeft - scatterPaddingRight;
const scatterUsableHeight =
  scatterHeight - scatterPaddingTop - scatterPaddingBottom;

const scatterRaces = racesWithReliableMistakeData
  .filter(
    (race) =>
      (race.data.distanceKm ?? 0) > 0 &&
      (race.data.mistakeSeconds ?? 0) >= 0
  )
  .map((race) => ({
    title: race.data.title,
    discipline: race.data.discipline?.trim() || 'Okänd',
    distanceKm: race.data.distanceKm ?? 0,
    mistakeSeconds: race.data.mistakeSeconds ?? 0
  }));

const maxScatterDistance = Math.max(
  1,
  ...scatterRaces.map((item) => item.distanceKm)
);
const maxScatterMistake = Math.max(
  60,
  ...scatterRaces.map((item) => item.mistakeSeconds)
);

const scatterPoints = scatterRaces.map((item) => ({
  ...item,
  color:
    disciplineColorMap.get(item.discipline) ??
    '#a0a0a0',
  x:
    scatterPaddingLeft +
    (item.distanceKm / maxScatterDistance) * scatterUsableWidth,
  y:
    scatterPaddingTop +
    scatterUsableHeight -
    (item.mistakeSeconds / maxScatterMistake) * scatterUsableHeight
}));

const scatterXTicks = [0, 0.25, 0.5, 0.75, 1].map((ratio) => ({
  ratio,
  x: scatterPaddingLeft + ratio * scatterUsableWidth,
  value: ratio * maxScatterDistance
}));

const scatterYTicks = [0, 0.25, 0.5, 0.75, 1].map((ratio) => ({
  ratio,
  y: scatterPaddingTop + scatterUsableHeight - ratio * scatterUsableHeight,
  value: ratio * maxScatterMistake
}));
---

<BaseLayout title="Statistik · Erik Martinssons Kartarkiv">
  <main class="archive-page page-shell statistics-page">
    <header class="statistics-header">
      <p class="eyebrow">KARTARKIV</p>
      <h1>Statistik</h1>
      <p>Statistik baserad på alla publicerade tävlingar i Kartarkivet. Sidan uppdateras automatiskt när nya kartor publiceras.</p>
    </header>

    <section class="statistics-section">
      <div class="statistics-section-heading">
        <div>
          <p class="eyebrow">ÖVERSIKT</p>
          <h2>Sammanställning</h2>
        </div>
      </div>

      <div class="statistics-metric-grid">
        <article class="statistics-metric">
          <span class="statistics-metric-icon" aria-hidden="true">⚑</span>
          <span>Antal tävlingar</span>
          <strong>{formatNumber(totalRaces)}</strong>
        </article>
        <article class="statistics-metric">
          <span class="statistics-metric-icon" aria-hidden="true">◷</span>
          <span>Total tävlingstid</span>
          <strong>{formatDuration(totalRaceSeconds)}</strong>
        </article>
        <article class="statistics-metric">
          <span class="statistics-metric-icon" aria-hidden="true">↔</span>
          <span>Total tävlingsdistans</span>
          <strong>{formatNumber(totalOfficialDistance, 1)} km</strong>
        </article>
        <article class="statistics-metric">
          <span class="statistics-metric-icon" aria-hidden="true">⌖</span>
          <span>Total GPS-distans</span>
          <strong>{formatNumber(totalGpsDistance, 1)} km</strong>
        </article>
        <article class="statistics-metric">
          <span class="statistics-metric-icon" aria-hidden="true">◎</span>
          <span>Antal kontroller</span>
          <strong>{formatNumber(totalControls)}</strong>
        </article>
        <article class="statistics-metric">
          <span class="statistics-metric-icon" aria-hidden="true">↔</span>
          <span>Snittdistans per lopp</span>
          <strong>{formatNumber(totalRaces ? totalOfficialDistance / totalRaces : 0, 1)} km</strong>
        </article>
      </div>
    </section>

    <section class="statistics-section">
      <div class="statistics-section-heading">
        <div>
          <p class="eyebrow">PLACERINGAR</p>
          <h2>Resultat</h2>
        </div>
      </div>

      <div class="statistics-metric-grid">
        <article class="statistics-metric">
          <span class="statistics-metric-icon" aria-hidden="true">↗</span>
          <span>Snittplacering</span>
          <strong>{formatNumber(Math.round(averagePlacement))}</strong>
        </article>
        <article class="statistics-metric">
          <span class="statistics-metric-icon" aria-hidden="true">♕</span>
          <span>Antal segrar</span>
          <strong>{formatNumber(victories)}</strong>
        </article>
        <article class="statistics-metric">
          <span class="statistics-metric-icon" aria-hidden="true">♛</span>
          <span>Antal pallplatser</span>
          <strong>{formatNumber(podiums)}</strong>
        </article>
        <article class="statistics-metric">
          <span class="statistics-metric-icon" aria-hidden="true">%</span>
          <span>Andel pallplatser</span>
          <strong>{formatNumber(podiumShare, 1)} %</strong>
        </article>
        <article class="statistics-metric">
          <span class="statistics-metric-icon" aria-hidden="true">10</span>
          <span>Antal topp 10</span>
          <strong>{formatNumber(topTen)}</strong>
        </article>
        <article class="statistics-metric">
          <span class="statistics-metric-icon" aria-hidden="true">%</span>
          <span>Andel topp 10</span>
          <strong>{formatNumber(topTenShare, 1)} %</strong>
        </article>
      </div>
    </section>

    <section class="statistics-section">
      <div class="statistics-section-heading">
        <div>
          <p class="eyebrow">ANALYS</p>
          <h2>Bommar</h2>
        </div>
      </div>

      <div class="statistics-metric-grid">
        <article class="statistics-metric">
          <span class="statistics-metric-icon" aria-hidden="true">◴</span>
          <span>Total bomtid</span>
          <strong>{formatDuration(totalMistakeSeconds)}</strong>
        </article>
        <article class="statistics-metric">
          <span class="statistics-metric-icon" aria-hidden="true">÷</span>
          <span>Genomsnittlig bom/lopp</span>
          <strong>{formatCompactDuration(averageMistakeSeconds)}</strong>
        </article>
        <article class="statistics-metric">
          <span class="statistics-metric-icon" aria-hidden="true">✓</span>
          <span>Lopp utan registrerad bom</span>
          <strong>{formatNumber(racesWithoutMistakes)}</strong>
        </article>
        <article class="statistics-metric">
          <span class="statistics-metric-icon" aria-hidden="true">✓%</span>
          <span>Andel utan registrerad bom</span>
          <strong>{formatNumber(mistakeFreeShare, 1)} %</strong>
        </article>
        <article class="statistics-metric">
          <span class="statistics-metric-icon" aria-hidden="true">!</span>
          <span>Största registrerade bomtid</span>
          <strong>{formatCompactDuration(largestMistake)}</strong>
        </article>
        <article class="statistics-metric statistics-metric-note">
          <span class="statistics-metric-icon" aria-hidden="true">?</span>
          <span>Vanligaste kontrollen att missa</span>
          <strong>—</strong>
          <small>Kontrollspecifika bommar sparas ännu inte i publicerade tävlingar.</small>
        </article>
      </div>
    </section>

    <section class="statistics-section">
      <div class="statistics-section-heading">
        <div>
          <p class="eyebrow">REKORD</p>
          <h2>Höjdpunkter</h2>
        </div>
      </div>

      <div class="statistics-record-grid">
        <article class="statistics-record">
          <span>Längsta tävling</span>
          <strong>{longestRace ? `${formatNumber(longestRace.data.distanceKm, 1)} km` : '—'}</strong>
          <small>{longestRace?.data.title ?? 'Ingen data'}</small>
        </article>
        <article class="statistics-record">
          <span>Kortaste tävling</span>
          <strong>{shortestRace ? `${formatNumber(shortestRace.data.distanceKm, 1)} km` : '—'}</strong>
          <small>{shortestRace?.data.title ?? 'Ingen data'}</small>
        </article>
        <article class="statistics-record">
          <span>Flest kontroller</span>
          <strong>{mostControlsRace?.data.controls ?? '—'}</strong>
          <small>{mostControlsRace?.data.title ?? 'Ingen data'}</small>
        </article>
        <article class="statistics-record">
          <span>Mest GPS-stigning</span>
          <strong>{mostClimbRace?.data.gpsClimb ? `${formatNumber(mostClimbRace.data.gpsClimb)} m` : '—'}</strong>
          <small>{mostClimbRace?.data.title ?? 'Ingen data'}</small>
        </article>
        <article class="statistics-record">
          <span>Störst bomtid</span>
          <strong>{mostMistakeRace ? formatCompactDuration(mostMistakeRace.data.mistakeSeconds ?? 0) : '—'}</strong>
          <small>{mostMistakeRace?.data.title ?? 'Ingen data'}</small>
        </article>
        <article class="statistics-record">
          <span>Snabbaste snittempo</span>
          <strong>{fastestRace ? `${formatCompactDuration(fastestRace.paceSeconds)} /km` : '—'}</strong>
          <small>{fastestRace?.race.data.title ?? 'Ingen data'}</small>
        </article>
      </div>
    </section>

    <section class="statistics-charts">
      <div class="statistics-section-heading"><div><p class="eyebrow">UTVECKLING</p><h2>Diagram</h2></div></div>
      <div class="statistics-chart-grid">
        <article class="panel statistics-chart-panel">
          <div class="statistics-chart-heading"><h3>Antal tävlingar per år</h3><p>Publicerade tävlingar fördelade över tid.</p></div>
          <div class="statistics-bar-chart">
            {yearly.map((item) => <div class="statistics-bar-column"><div class="statistics-bar-track"><div class="statistics-bar-stack" style={`height: ${(item.races / maxRacesPerYear) * 100}%`}><div class="statistics-bar-value">{item.races}</div><div class="statistics-bar-fill"></div></div></div><span>{item.year}</span></div>)}
          </div>
        </article>

        <article class="panel statistics-chart-panel">
          <div class="statistics-chart-heading"><h3>Löpta kilometer per år</h3><p>GPS-distans där den finns, annars officiell banlängd.</p></div>
          <div class="statistics-bar-chart">
            {yearly.map((item) => <div class="statistics-bar-column"><div class="statistics-bar-track"><div class="statistics-bar-stack" style={`height: ${(item.distanceKm / maxDistancePerYear) * 100}%`}><div class="statistics-bar-value">{formatNumber(item.distanceKm, 0)}</div><div class="statistics-bar-fill"></div></div></div><span>{item.year}</span></div>)}
          </div>
        </article>

        <article class="panel statistics-chart-panel">
          <div class="statistics-chart-heading"><h3>Antal kontroller per år</h3><p>Summan av registrerade kontroller för årets tävlingar.</p></div>
          <div class="statistics-bar-chart">
            {yearly.map((item) => <div class="statistics-bar-column"><div class="statistics-bar-track"><div class="statistics-bar-stack" style={`height: ${(item.controls / maxControlsPerYear) * 100}%`}><div class="statistics-bar-value">{formatNumber(item.controls)}</div><div class="statistics-bar-fill"></div></div></div><span>{item.year}</span></div>)}
          </div>
        </article>

        <article class="panel statistics-chart-panel statistics-chart-wide">
          <div class="statistics-chart-heading"><h3>Genomsnittlig bomtid per år</h3><p>Genomsnittlig registrerad bomtid per tävling.</p></div>
          {linePoints.length > 0 ? <div class="statistics-line-chart-wrap"><svg class="statistics-line-chart" viewBox={`0 0 ${lineWidth} ${lineHeight}`} role="img" aria-label="Genomsnittlig bomtid per år">
            {[0, 0.25, 0.5, 0.75, 1].map((ratio) => { const y = linePaddingY + usableHeight - ratio * usableHeight; return <line x1={linePaddingX} x2={lineWidth - linePaddingX} y1={y} y2={y} class="statistics-grid-line" />; })}
            <path d={linePath} class="statistics-line-path" />
            {linePoints.map((point) => <g><circle cx={point.x} cy={point.y} r="6" fill="#ff7a00" stroke="none" /><text x={point.x} y={point.y - 14} text-anchor="middle" class="statistics-line-value">{formatCompactDuration(point.averageMistakeSeconds)}</text><text x={point.x} y={lineHeight - 5} text-anchor="middle" class="statistics-line-year">{point.year}</text></g>)}
          </svg></div> : <p class="statistics-empty-chart">Ingen statistik ännu.</p>}
        </article>

        <article class="panel statistics-chart-panel statistics-chart-wide">
          <div class="statistics-chart-heading">
            <h3>Banlängd vs bomtid</h3>
            <p>Varje punkt är ett lopp med tillförlitligt WinSplits-underlag. Stafetter är exkluderade.</p>
          </div>

          {

            scatterPoints.length > 0 ? (
              <div class="statistics-line-chart-wrap">
                <svg
                  class="statistics-line-chart"
                  viewBox={`0 0 ${scatterWidth} ${scatterHeight}`}
                  role="img"
                  aria-labelledby="scatter-title scatter-desc"
                >
                  <title id="scatter-title">Banlängd jämfört med registrerad bomtid</title>
                  <desc id="scatter-desc">
                    Varje punkt motsvarar ett lopp. Den horisontella axeln visar banlängd i kilometer och den vertikala axeln visar registrerad bomtid.
                  </desc>

                  {scatterYTicks.map((tick) => (
                    <g>
                      <line
                        x1={scatterPaddingLeft}
                        x2={scatterWidth - scatterPaddingRight}
                        y1={tick.y}
                        y2={tick.y}
                        class="statistics-grid-line"
                      />
                      <text
                        x={scatterPaddingLeft - 10}
                        y={tick.y + 4}
                        text-anchor="end"
                        class="statistics-line-year"
                      >
                        {formatCompactDuration(tick.value)}
                      </text>
                    </g>
                  ))}

                  {scatterXTicks.map((tick) => (
                    <g>
                      <line
                        x1={tick.x}
                        x2={tick.x}
                        y1={scatterPaddingTop}
                        y2={scatterHeight - scatterPaddingBottom}
                        class="statistics-grid-line"
                      />
                      <text
                        x={tick.x}
                        y={scatterHeight - 24}
                        text-anchor="middle"
                        class="statistics-line-year"
                      >
                        {formatNumber(tick.value, 1)}
                      </text>
                    </g>
                  ))}

                  <text
                    x={scatterWidth / 2}
                    y={scatterHeight - 5}
                    text-anchor="middle"
                    class="statistics-line-year"
                  >
                    Banlängd (km)
                  </text>

                  <text
                    x="14"
                    y={scatterHeight / 2}
                    text-anchor="middle"
                    class="statistics-line-year"
                    transform={`rotate(-90 14 ${scatterHeight / 2})`}
                  >
                    Bomtid
                  </text>

                  {scatterPoints.map((point) => (
                    <g>
                      <title>
                        {`${point.title} · ${formatNumber(point.distanceKm, 2)} km · ${formatCompactDuration(point.mistakeSeconds)}`}
                      </title>
                      <circle
                        cx={point.x}
                        cy={point.y}
                        r="4"
                        fill={point.color}
                        stroke="none"
                      />
                    </g>
                  ))}
                </svg>
              </div>
            ) : (
              <p class="statistics-empty-chart">Ingen statistik ännu.</p>
            )
          }
        </article>

        <article class="panel statistics-chart-panel statistics-chart-wide">
          <div class="statistics-chart-heading">
            <h3>Snittfart (min/km) per år</h3>
            <p>Total tävlingstid dividerad med löpt distans för respektive år.</p>
          </div>

          {
            pacePoints.length > 0 ? (
              <div class="statistics-line-chart-wrap">
                <svg
                  class="statistics-line-chart"
                  viewBox={`0 0 ${lineWidth} ${lineHeight}`}
                  role="img"
                  aria-labelledby="pace-line-title pace-line-desc"
                >
                  <title id="pace-line-title">Snittfart i minuter per kilometer per år</title>
                  <desc id="pace-line-desc">
                    Linje med en punkt för varje år. Värdet visar genomsnittliga minuter per kilometer.
                  </desc>

                  {paceYTicks.map((tick) => {
                    const y =
                      linePaddingY +
                      usableHeight -
                      ((tick - paceMin) / paceRange) * usableHeight;

                    return (
                      <g>
                        <line
                          x1={linePaddingX}
                          x2={lineWidth - linePaddingX}
                          y1={y}
                          y2={y}
                          class="statistics-grid-line"
                        />
                        <text
                          x={linePaddingX - 10}
                          y={y + 4}
                          text-anchor="end"
                          class="statistics-line-year"
                        >
                          {formatCompactDuration(tick)}
                        </text>
                      </g>
                    );
                  })}

                  <path d={pacePath} class="statistics-line-path" />

                  {
                    pacePoints.map((point) => (
                      <g>
                        <circle cx={point.x} cy={point.y} r="6" fill="#ff7a00" stroke="none" />
                        <text
                          x={point.x}
                          y={point.y - 14}
                          text-anchor="middle"
                          class="statistics-line-value"
                        >
                          {formatCompactDuration(point.paceSecondsPerKm)}
                        </text>
                        <text
                          x={point.x}
                          y={lineHeight - 5}
                          text-anchor="middle"
                          class="statistics-line-year"
                        >
                          {point.year}
                        </text>
                      </g>
                    ))
                  }
                </svg>
              </div>
            ) : (
              <p class="statistics-empty-chart">Ingen statistik ännu.</p>
            )
          }
        </article>

        <article class="panel statistics-chart-panel statistics-chart-wide">
          <div class="statistics-chart-heading">
            <h3>Genomsnittlig extra löpsträcka per år</h3>
            <p>Skillnaden mellan GPS-distans och officiell banlängd, i procent av banlängden. Lägre värde innebär rakare vägval.</p>
          </div>

          {
            extraDistancePoints.length > 0 ? (
              <div class="statistics-line-chart-wrap">
                <svg
                  class="statistics-line-chart"
                  viewBox={`0 0 ${lineWidth} ${lineHeight}`}
                  role="img"
                  aria-labelledby="extra-distance-title extra-distance-desc"
                >
                  <title id="extra-distance-title">Genomsnittlig extra löpsträcka per år</title>
                  <desc id="extra-distance-desc">
                    Linje med en punkt för varje år. Värdet visar hur många procent längre GPS-distansen i genomsnitt är än den officiella banlängden.
                  </desc>

                  {extraDistanceYTicks.map((tick) => {
                    const y =
                      linePaddingY +
                      usableHeight -
                      ((tick - extraDistanceMin) / extraDistanceRange) *
                        usableHeight;

                    return (
                      <g>
                        <line
                          x1={linePaddingX}
                          x2={lineWidth - linePaddingX}
                          y1={y}
                          y2={y}
                          class="statistics-grid-line"
                        />
                        <text
                          x={linePaddingX - 10}
                          y={y + 4}
                          text-anchor="end"
                          class="statistics-line-year"
                        >
                          {formatNumber(tick, 1)} %
                        </text>
                      </g>
                    );
                  })}

                  <path
                    d={extraDistancePath}
                    fill="none"
                    stroke="#f3b24b"
                    stroke-width="3"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />

                  {
                    extraDistancePoints.map((point) => (
                      <g>
                        <circle
                          cx={point.x}
                          cy={point.y}
                          r="6"
                          fill="#f3b24b"
                          stroke="none"
                        />
                        <text
                          x={point.x}
                          y={point.y - 14}
                          text-anchor="middle"
                          class="statistics-line-value"
                        >
                          {formatNumber(point.averageExtraPercent, 1)} %
                        </text>
                        <text
                          x={point.x}
                          y={lineHeight - 5}
                          text-anchor="middle"
                          class="statistics-line-year"
                        >
                          {point.year}
                        </text>
                      </g>
                    ))
                  }
                </svg>
              </div>
            ) : (
              <p class="statistics-empty-chart">Ingen statistik ännu.</p>
            )
          }
        </article>

        <article class="panel statistics-chart-panel statistics-chart-half">
          <div class="statistics-chart-heading">
            <h3>Genomsnittlig bomtid per disciplin</h3>
            <p>Endast lopp med tillförlitligt WinSplits-underlag. Stafetter är exkluderade.</p>
          </div>
          {
            disciplineMistakeStats.length > 0 ? (
              <div class="statistics-line-chart-wrap">
                <svg
                  class="statistics-line-chart"
                  viewBox={`0 0 620 ${Math.max(250, disciplineMistakeStats.length * 58 + 60)}`}
                  role="img"
                  aria-labelledby="discipline-mistake-title discipline-mistake-desc"
                >
                  <title id="discipline-mistake-title">Genomsnittlig bomtid per disciplin</title>
                  <desc id="discipline-mistake-desc">
                    Liggande stapeldiagram sorterat efter hur många tävlingar som sprungits i varje disciplin.
                  </desc>

                  {disciplineMistakeStats.map((item, index) => {
                    const y = 34 + index * 58;
                    const barWidth =
                      (item.averageMistakeSeconds / maxDisciplineMistakeAverage) * 410;
                    const color =
                      disciplineColorMap.get(item.discipline) ?? '#a0a0a0';

                    return (
                      <g>
                        <text
                          x="12"
                          y={y + 18}
                          class="statistics-line-year"
                        >
                          {item.discipline}
                        </text>

                        <rect
                          x="112"
                          y={y}
                          width="410"
                          height="24"
                          rx="6"
                          fill="rgba(255, 255, 255, 0.06)"
                        />

                        <rect
                          x="112"
                          y={y}
                          width={Math.max(2, barWidth)}
                          height="24"
                          rx="6"
                          fill={color}
                        />

                        <text
                          x={Math.min(590, 124 + barWidth)}
                          y={y + 18}
                          class="statistics-line-value"
                        >
                          {formatCompactDuration(item.averageMistakeSeconds)}
                        </text>
                      </g>
                    );
                  })}
                </svg>
              </div>
            ) : (
              <p class="statistics-empty-chart">Ingen statistik ännu.</p>
            )
          }
        </article>

        <article class="panel statistics-chart-panel statistics-chart-half">
          <div class="statistics-chart-heading"><h3>Fördelning per disciplin</h3><p>Andel av samtliga publicerade tävlingar.</p></div>
          <div class="statistics-discipline-layout">
            <div class="statistics-pie" style={`--statistics-pie: ${pieBackground}`} role="img" aria-label="Cirkeldiagram över tävlingarnas disciplinfördelning"><div><strong>{totalRaces}</strong><span>tävlingar</span></div></div>
            <div class="statistics-legend">
              {disciplineStats.map((item, index) => <div class="statistics-legend-item"><span class="statistics-legend-color" style={`background: ${pieColors[index % pieColors.length]}`}></span><div><strong>{item.discipline}</strong><span>{item.count} · {formatNumber(item.share, 1)} %</span></div></div>)}
            </div>
          </div>
        </article>
      </div>
    </section>

    <section class="statistics-section statistics-top-mistakes">
      <div class="statistics-section-heading">
        <div>
          <p class="eyebrow">TOPP 5</p>
          <h2>Störst registrerad bomtid</h2>
        </div>
      </div>

      <div class="panel statistics-ranking-panel">
        {
          topMistakeRaces.length > 0 ? (
            <div class="statistics-table-wrap">
              <table class="statistics-ranking-table">
                <thead>
                  <tr>
                    <th scope="col">#</th>
                    <th scope="col">Lopp</th>
                    <th scope="col">År</th>
                    <th scope="col">Bomtid</th>
                    <th scope="col">Disciplin</th>
                    <th scope="col">Plats</th>
                  </tr>
                </thead>
                <tbody>
                  {topMistakeRaces.map((race, index) => (
                    <tr>
                      <td class="statistics-ranking-position">
                        {index + 1}
                      </td>
                      <td>
                        <a
                          class="statistics-race-link"
                          href={raceArchiveUrl(race)}
                        >
                          {race.data.title}
                        </a>
                      </td>
                      <td>{race.data.date.getFullYear()}</td>
                      <td class="statistics-ranking-mistake">
                        {formatCompactDuration(race.data.mistakeSeconds ?? 0)}
                      </td>
                      <td>{race.data.discipline?.trim() || 'Okänd'}</td>
                      <td>{race.data.location?.trim() || '—'}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          ) : (
            <p class="statistics-empty-chart">
              Ingen registrerad bomtid ännu.
            </p>
          )
        }
      </div>
    </section>

    <p class="statistics-update-note">
      Statistiken uppdateras automatiskt när nya tävlingar publiceras.
    </p>
  </main>

  <style>
    .statistics-ranking-panel {
      overflow: hidden;
    }

    .statistics-table-wrap {
      width: 100%;
      overflow-x: auto;
    }

    .statistics-ranking-table {
      width: 100%;
      border-collapse: collapse;
      min-width: 720px;
    }

    .statistics-ranking-table th,
    .statistics-ranking-table td {
      padding: 0.9rem 1rem;
      text-align: left;
      border-bottom: 1px solid rgba(255, 255, 255, 0.09);
      vertical-align: middle;
    }

    .statistics-ranking-table th {
      color: var(--muted, #a0a0a0);
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    .statistics-ranking-table tbody tr:last-child td {
      border-bottom: 0;
    }

    .statistics-ranking-table tbody tr:hover {
      background: rgba(255, 255, 255, 0.025);
    }

    .statistics-ranking-position {
      width: 3rem;
      color: #ff7a00;
      font-weight: 800;
    }

    .statistics-ranking-mistake {
      font-variant-numeric: tabular-nums;
      font-weight: 800;
      color: #ff7a00;
      white-space: nowrap;
    }

    .statistics-race-link {
      color: inherit;
      font-weight: 800;
      text-decoration: none;
    }

    .statistics-race-link:hover,
    .statistics-race-link:focus-visible {
      color: #ff7a00;
      text-decoration: underline;
      text-underline-offset: 0.18em;
    }
  </style>
</BaseLayout>
