    }

    .statistics-profile-table th,
    .statistics-profile-table td {
      padding: 0.85rem 1rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.09);
      text-align: center;
      font-variant-numeric: tabular-nums;
    }

    .statistics-profile-table thead th {
      color: rgba(245, 245, 245, 0.9);
      font-size: 0.82rem;
      font-weight: 700;
    }

    .statistics-profile-table thead th:first-child,
    .statistics-profile-table tbody th { text-align: left; }
    .statistics-profile-table tbody th strong { display: block; color: rgba(245,245,245,.92); }
    .statistics-profile-table tbody th small { display: block; margin-top: .12rem; color: var(--muted, #a0a0a0); font-weight: 400; }
    .statistics-profile-period-a { color: #f3b24b; font-weight: 800; }
    .statistics-profile-period-b { color: #ff7a00; font-weight: 800; }
    .statistics-profile-change { font-weight: 800; white-space: nowrap; }
    .statistics-profile-change.is-improved { color: #69c267; }
    .statistics-profile-change.is-worse { color: #e06b65; }

    .statistics-radar-note {
      margin: 0.8rem auto 0;
      max-width: 760px;
