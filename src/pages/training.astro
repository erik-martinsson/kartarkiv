---
import fs from 'node:fs';
import path from 'node:path';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const csvPath = path.join(process.cwd(), 'src', 'data', 'training', 'attackpoint.csv');
const csvText = fs.readFileSync(csvPath, 'utf8').replace(/^\uFEFF/, '');

const parseCsv = (text) => {
  const rows = [];
  let row = [];
  let field = '';
  let quoted = false;

  for (let i = 0; i < text.length; i += 1) {
    const char = text[i];

    if (quoted) {
      if (char === '"' && text[i + 1] === '"') {
        field += '"';
        i += 1;
      } else if (char === '"') {
        quoted = false;
      } else {
        field += char;
      }
      continue;
    }

    if (char === '"') {
      quoted = true;
    } else if (char === ',') {
      row.push(field);
      field = '';
    } else if (char === '\n') {
      row.push(field.replace(/\r$/, ''));
      rows.push(row);
      row = [];
      field = '';
    } else {
      field += char;
    }
  }

  if (field.length > 0 || row.length > 0) {
    row.push(field.replace(/\r$/, ''));
    rows.push(row);
  }

  const [headers, ...body] = rows.filter((item) => item.some((value) => value !== ''));
  return body.map((values) =>
    Object.fromEntries(headers.map((header, index) => [header, values[index] ?? '']))
  );
};

const toNumber = (value) => {
  const normalized = String(value ?? '').trim().replace(',', '.');
  if (!normalized) return 0;
  const parsed = Number(normalized);
  return Number.isFinite(parsed) ? parsed : 0;
};

const timeToSeconds = (value) => {
  const parts = String(value ?? '').trim().split(':').map(Number);
  if (parts.length < 2 || parts.some(Number.isNaN)) return 0;
  return parts.reduce((total, part) => total * 60 + part, 0);
};

const isFlag = (value) => {
  const normalized = String(value ?? '').trim().toLowerCase();
  return normalized !== '' && normalized !== '0' && normalized !== 'false' && normalized !== 'no';
};

const formatNumber = (value, decimals = 0) =>
  Number(value || 0).toLocaleString('sv-SE', {
    minimumFractionDigits: decimals,
    maximumFractionDigits: decimals
  });

const formatHours = (seconds) =>
  `${formatNumber(seconds / 3600, seconds >= 360000 ? 0 : 1)} h`;


const formatCompactDuration = (seconds) => {
  const rounded = Math.max(0, Math.round(Number(seconds) || 0));
  const minutes = Math.floor(rounded / 60);
  const remainingSeconds = rounded % 60;
  return `${minutes}:${String(remainingSeconds).padStart(2, '0')}`;
};

const races = (await getCollection('races')).sort(
  (a, b) => a.data.date.getTime() - b.data.date.getTime()
);

const rawRows = parseCsv(csvText);

const trainingRows = rawRows
  .filter((row) => /^\d{4}-\d{2}-\d{2}$/.test(row.date ?? ''))
  .map((row) => {
    const date = new Date(`${row.date}T12:00:00`);
    return {
      date: row.date,
      year: date.getFullYear(),
      month: date.getMonth() + 1,
      activity: (row.activity ?? '').trim() || 'Övrigt',
      seconds: timeToSeconds(row.time),
      distanceKm: toNumber(row['distance(km)']),
      climbM: toNumber(row['climb(m)']),
      sick: isFlag(row.sick),
      injured: isFlag(row.injured),
      restday: isFlag(row.restday)
    };
  });

const years = [...new Set(trainingRows.map((row) => row.year))].sort((a, b) => b - a);
const latestYear = years[0] ?? new Date().getFullYear();

const activityOrder = [
  'Running',
  'Orientering',
  'Löpning terräng',
  'Skidor',
  'Rullskidor',
  'Styrka',
  'Cykel',
  'SkiErg'
];

const activityColors = [
  '#ff7a00',
  '#f3b24b',
  '#dd5f38',
  '#c44767',
  '#965b9e',
  '#5d75b8',
  '#3f8b9c',
  '#4f9b78'
];

const buildSummary = (rows) => {
  const active = rows.filter((row) => row.seconds > 0);
  const uniqueFlagDates = (key) =>
    new Set(rows.filter((row) => row[key]).map((row) => row.date)).size;

  return {
    seconds: active.reduce((sum, row) => sum + row.seconds, 0),
    distanceKm: active.reduce((sum, row) => sum + row.distanceKm, 0),
    climbM: active.reduce((sum, row) => sum + row.climbM, 0),
    orienteeringSeconds: active
      .filter((row) => row.activity === 'Orientering')
      .reduce((sum, row) => sum + row.seconds, 0),
    sessions: active.length,
    sickDays: uniqueFlagDates('sick'),
    injuredDays: uniqueFlagDates('injured'),
    restDays: uniqueFlagDates('restday')
  };
};

const summariesByYear = Object.fromEntries(
  years.map((year) => [year, buildSummary(trainingRows.filter((row) => row.year === year))])
);
const allSummary = buildSummary(trainingRows);

const yearly = [...years].reverse().map((year) => ({
  year,
  ...summariesByYear[year]
}));

const maxYearSeconds = Math.max(1, ...yearly.map((item) => item.seconds));

const activityStatsFor = (rows) => {
  const map = new Map();
  for (const row of rows) {
    if (row.seconds <= 0) continue;
    map.set(row.activity, (map.get(row.activity) ?? 0) + row.seconds);
  }

  const total = [...map.values()].reduce((sum, value) => sum + value, 0);
  return [...map.entries()]
    .map(([activity, seconds]) => ({
      activity,
      seconds,
      share: total > 0 ? (seconds / total) * 100 : 0
    }))
    .sort((a, b) => b.seconds - a.seconds);
};

const monthlyForYear = (year) => {
  const monthNames = ['Jan', 'Feb', 'Mar', 'Apr', 'Maj', 'Jun', 'Jul', 'Aug', 'Sep', 'Okt', 'Nov', 'Dec'];
  const rows = trainingRows.filter((row) => row.year === year);
  return monthNames.map((label, index) => ({
    label,
    seconds: rows
      .filter((row) => row.month === index + 1)
      .reduce((sum, row) => sum + row.seconds, 0)
  }));
};

const chartData = Object.fromEntries(
  years.map((year) => {
    const rows = trainingRows.filter((row) => row.year === year);
    return [
      year,
      {
        summary: summariesByYear[year],
        monthly: monthlyForYear(year),
        activities: activityStatsFor(rows)
      }
    ];
  })
);

chartData.all = {
  summary: allSummary,
  monthly: [],
  activities: activityStatsFor(trainingRows)
};

const latestMonthly = chartData[latestYear]?.monthly ?? [];
const maxLatestMonthSeconds = Math.max(1, ...latestMonthly.map((item) => item.seconds));
const latestActivities = chartData[latestYear]?.activities ?? [];


const dateOnly = (date) => {
  const year = date.getFullYear();
  const month = String(date.getMonth() + 1).padStart(2, '0');
  const day = String(date.getDate()).padStart(2, '0');
  return `${year}-${month}-${day}`;
};

const raceArchiveUrl = (race) => {
  const id = String(race.id ?? '').replace(/^\/+|\/+$/g, '');
  return `/races/${id}/`;
};

const percentileForRace = (race) => {
  const position = race.data.position ?? 0;
  const starters = race.data.starters ?? 0;
  if (starters < 2 || position < 1 || position > starters) return null;
  return ((starters - position) / (starters - 1)) * 100;
};

const trainingWindowBeforeRace = (raceDate, days = 28) => {
  const raceDay = dateOnly(raceDate);
  const end = new Date(raceDate);
  end.setDate(end.getDate() - 1);
  end.setHours(23, 59, 59, 999);

  const start = new Date(raceDate);
  start.setDate(start.getDate() - days);
  start.setHours(0, 0, 0, 0);

  const rows = trainingRows.filter((row) => {
    const date = new Date(`${row.date}T12:00:00`);
    return row.date !== raceDay && date >= start && date <= end;
  });

  const active = rows.filter((row) => row.seconds > 0);
  const runningActivities = new Set(['Running', 'Löpning terräng']);
  const orienteering = active.filter((row) => row.activity === 'Orientering');
  const running = active.filter((row) => runningActivities.has(row.activity));

  return {
    seconds: active.reduce((sum, row) => sum + row.seconds, 0),
    distanceKm: active.reduce((sum, row) => sum + row.distanceKm, 0),
    climbM: active.reduce((sum, row) => sum + row.climbM, 0),
    sessions: active.length,
    orienteeringSeconds: orienteering.reduce((sum, row) => sum + row.seconds, 0),
    orienteeringSessions: orienteering.length,
    runningSeconds: running.reduce((sum, row) => sum + row.seconds, 0),
    runningDistanceKm: running.reduce((sum, row) => sum + row.distanceKm, 0),
    sickDays: new Set(rows.filter((row) => row.sick).map((row) => row.date)).size,
    injuredDays: new Set(rows.filter((row) => row.injured).map((row) => row.date)).size,
    restDays: new Set(rows.filter((row) => row.restday).map((row) => row.date)).size
  };
};

const daysSinceLastTraining = (raceDate) => {
  const raceDay = dateOnly(raceDate);
  const previous = trainingRows
    .filter((row) => row.seconds > 0 && row.date < raceDay)
    .map((row) => row.date)
    .sort()
    .at(-1);

  if (!previous) return null;
  const race = new Date(`${raceDay}T12:00:00`);
  const prev = new Date(`${previous}T12:00:00`);
  return Math.max(0, Math.round((race.getTime() - prev.getTime()) / 86400000));
};

const medianNumber = (values) => {
  const valid = values.filter((value) => Number.isFinite(value)).sort((a, b) => a - b);
  if (valid.length === 0) return null;
  const middle = Math.floor(valid.length / 2);
  return valid.length % 2
    ? valid[middle]
    : (valid[middle - 1] + valid[middle]) / 2;
};

const quantileBreaks = (values) => {
  const sorted = values.filter((value) => Number.isFinite(value)).sort((a, b) => a - b);
  if (sorted.length < 4) return [];
  const q = (ratio) => {
    const index = (sorted.length - 1) * ratio;
    const lower = Math.floor(index);
    const upper = Math.ceil(index);
    if (lower === upper) return sorted[lower];
    const weight = index - lower;
    return sorted[lower] * (1 - weight) + sorted[upper] * weight;
  };
  return [q(0.25), q(0.5), q(0.75)];
};

const bucketQuartiles = (items, valueKey, metricKey, formatter = (value) => value) => {
  const eligible = items.filter(
    (item) => Number.isFinite(item[valueKey]) && Number.isFinite(item[metricKey])
  );
  const breaks = quantileBreaks(eligible.map((item) => item[valueKey]));
  if (breaks.length !== 3) return [];

  const buckets = [
    { label: 'Lägst', min: -Infinity, max: breaks[0], values: [], rawValues: [] },
    { label: 'Låg–medel', min: breaks[0], max: breaks[1], values: [], rawValues: [] },
    { label: 'Medel–hög', min: breaks[1], max: breaks[2], values: [], rawValues: [] },
    { label: 'Högst', min: breaks[2], max: Infinity, values: [], rawValues: [] }
  ];

  for (const item of eligible) {
    const index =
      item[valueKey] <= breaks[0] ? 0 :
      item[valueKey] <= breaks[1] ? 1 :
      item[valueKey] <= breaks[2] ? 2 : 3;
    buckets[index].values.push(item[metricKey]);
    buckets[index].rawValues.push(item[valueKey]);
  }

  return buckets.map((bucket) => ({
    label: bucket.label,
    count: bucket.values.length,
    median: medianNumber(bucket.values) ?? 0,
    inputMedian: medianNumber(bucket.rawValues) ?? 0,
    inputLabel: formatter(medianNumber(bucket.rawValues) ?? 0)
  }));
};

const raceTrainingLinks = races
  .map((race) => {
    const percentile = percentileForRace(race);
    const raceSeconds = timeToSeconds(race.data.time);
    const raceDistance = race.data.gpsDistanceKm ?? race.data.distanceKm ?? 0;
    const racePaceSeconds = raceSeconds > 0 && raceDistance > 0
      ? raceSeconds / raceDistance
      : null;
    const mistakeShare =
      race.data.discipline !== 'Stafett' &&
      race.data.winsplits &&
      raceSeconds > 0
        ? ((race.data.mistakeSeconds ?? 0) / raceSeconds) * 100
        : null;

    const load7 = trainingWindowBeforeRace(race.data.date, 7);
    const load28 = trainingWindowBeforeRace(race.data.date, 28);
    const load90 = trainingWindowBeforeRace(race.data.date, 90);
    const sameDayAttackpoint = trainingRows.filter((row) => row.date === dateOnly(race.data.date));

    return {
      id: race.id,
      title: race.data.title ?? race.data.name ?? String(race.id),
      date: dateOnly(race.data.date),
      year: race.data.date.getFullYear(),
      discipline: race.data.discipline ?? '—',
      position: race.data.position,
      starters: race.data.starters,
      percentile,
      racePaceSeconds,
      mistakeShare,
      trainingHours7: load7.seconds / 3600,
      trainingHours28: load28.seconds / 3600,
      trainingHours90: load90.seconds / 3600,
      trainingKm28: load28.distanceKm,
      climb28: load28.climbM,
      orienteeringHours28: load28.orienteeringSeconds / 3600,
      orienteeringSessions28: load28.orienteeringSessions,
      runningHours28: load28.runningSeconds / 3600,
      runningKm28: load28.runningDistanceKm,
      sickDays14: trainingWindowBeforeRace(race.data.date, 14).sickDays,
      injuredDays14: trainingWindowBeforeRace(race.data.date, 14).injuredDays,
      restDays7: load7.restDays,
      daysSinceTraining: daysSinceLastTraining(race.data.date),
      hasAttackpointSameDay: sameDayAttackpoint.some((row) => row.seconds > 0),
      url: raceArchiveUrl(race)
    };
  });

const completeResultLinks = raceTrainingLinks.filter((item) => Number.isFinite(item.percentile));
const reliableMistakeLinks = raceTrainingLinks.filter((item) => Number.isFinite(item.mistakeShare));
const pacedRaceLinks = raceTrainingLinks.filter((item) => Number.isFinite(item.racePaceSeconds));

const resultByTrainingQuartile = bucketQuartiles(
  completeResultLinks,
  'trainingHours28',
  'percentile',
  (value) => `${formatNumber(value, 1)} h`
);

const resultByOrienteeringQuartile = bucketQuartiles(
  completeResultLinks,
  'orienteeringHours28',
  'percentile',
  (value) => `${formatNumber(value, 1)} h`
);

const mistakesByOrienteeringQuartile = bucketQuartiles(
  reliableMistakeLinks,
  'orienteeringHours28',
  'mistakeShare',
  (value) => `${formatNumber(value, 1)} h`
);

const paceByRunningQuartile = bucketQuartiles(
  pacedRaceLinks,
  'runningKm28',
  'racePaceSeconds',
  (value) => `${formatNumber(value, 0)} km`
);

const recoveryGroups = [
  { label: '0–1 dag', min: 0, max: 1 },
  { label: '2 dagar', min: 2, max: 2 },
  { label: '3 dagar', min: 3, max: 3 },
  { label: '4+ dagar', min: 4, max: Infinity }
].map((group) => {
  const values = completeResultLinks
    .filter(
      (item) =>
        Number.isFinite(item.daysSinceTraining) &&
        item.daysSinceTraining >= group.min &&
        item.daysSinceTraining <= group.max
    )
    .map((item) => item.percentile);

  return {
    ...group,
    count: values.length,
    median: medianNumber(values) ?? 0
  };
});

const illnessGroups = [
  {
    label: 'Ingen sjukdag',
    items: completeResultLinks.filter((item) => item.sickDays14 === 0)
  },
  {
    label: 'Sjuk senaste 14 d',
    items: completeResultLinks.filter((item) => item.sickDays14 > 0)
  }
].map((group) => ({
  label: group.label,
  count: group.items.length,
  median: medianNumber(group.items.map((item) => item.percentile)) ?? 0
}));

const injuryGroups = [
  {
    label: 'Ingen skadedag',
    items: completeResultLinks.filter((item) => item.injuredDays14 === 0)
  },
  {
    label: 'Skadad senaste 14 d',
    items: completeResultLinks.filter((item) => item.injuredDays14 > 0)
  }
].map((group) => ({
  label: group.label,
  count: group.items.length,
  median: medianNumber(group.items.map((item) => item.percentile)) ?? 0
}));

const yearlyRaceTraining = years
  .slice()
  .reverse()
  .map((year) => {
    const resultItems = completeResultLinks.filter((item) => item.year === year);
    const training = summariesByYear[year];
    return {
      year,
      trainingHours: (training?.seconds ?? 0) / 3600,
      medianResult: medianNumber(resultItems.map((item) => item.percentile)),
      races: resultItems.length
    };
  })
  .filter((item) => item.races > 0);

const maxYearTrainingHours = Math.max(
  1,
  ...yearlyRaceTraining.map((item) => item.trainingHours)
);

const latestLinkedRaces = [...completeResultLinks].reverse().slice(0, 12);

const statusByYear = yearly.map((item) => ({
  year: item.year,
  sickDays: item.sickDays,
  injuredDays: item.injuredDays,
  restDays: item.restDays
}));
const maxStatusDays = Math.max(
  1,
  ...statusByYear.flatMap((item) => [item.sickDays, item.injuredDays, item.restDays])
);
---

<BaseLayout title="Training · Erik Martinssons Kartarkiv">
  <main class="archive-page page-shell training-page">
    <header class="training-header">
      <div>
        <p class="eyebrow">KARTARKIV</p>
        <h1>Training</h1>
        <p>Träningsstatistik från Attackpoint. Rådata läses vid build och exponeras inte som en publik CSV-fil.</p>
      </div>

      <label class="training-year-picker">
        <span>Period</span>
        <select id="training-year">
          {years.map((year) => <option value={String(year)} selected={year === latestYear}>{year}</option>)}
          <option value="all">Alla år</option>
        </select>
      </label>
    </header>

    <section class="training-section">
      <div class="training-section-heading">
        <div><p class="eyebrow">ÖVERSIKT</p><h2 id="overview-title">{latestYear}</h2></div>
      </div>

      <div class="training-metric-grid">
        <article class="training-metric"><span>◷</span><small>Träningstid</small><strong id="metric-hours">{formatHours(summariesByYear[latestYear]?.seconds ?? 0)}</strong></article>
        <article class="training-metric"><span>↔</span><small>Distans</small><strong id="metric-distance">{formatNumber(summariesByYear[latestYear]?.distanceKm ?? 0, 0)} km</strong></article>
        <article class="training-metric"><span>↗</span><small>Höjdmeter</small><strong id="metric-climb">{formatNumber(summariesByYear[latestYear]?.climbM ?? 0, 0)} m</strong></article>
        <article class="training-metric"><span>⌖</span><small>Orientering</small><strong id="metric-orienteering">{formatHours(summariesByYear[latestYear]?.orienteeringSeconds ?? 0)}</strong></article>
        <article class="training-metric"><span>+</span><small>Antal pass</small><strong id="metric-sessions">{formatNumber(summariesByYear[latestYear]?.sessions ?? 0)}</strong></article>
        <article class="training-metric"><span>●</span><small>Sjuk / skadad</small><strong id="metric-status">{summariesByYear[latestYear]?.sickDays ?? 0} / {summariesByYear[latestYear]?.injuredDays ?? 0} d</strong></article>
      </div>
    </section>

    <section class="training-section">
      <div class="training-section-heading"><div><p class="eyebrow">UTVECKLING</p><h2>Träningsmängd</h2></div></div>

      <div class="training-chart-grid">
        <article class="panel training-chart-panel training-chart-wide" id="monthly-panel">
          <div class="training-chart-heading"><h3>Träningstid per månad</h3><p id="monthly-subtitle">Total registrerad träningstid per månad under {latestYear}.</p></div>
          <div class="training-bars" id="monthly-chart">
            {latestMonthly.map((item) => (
              <div class="training-bar-column">
                <div class="training-bar-track">
                  <div class="training-bar-stack" style={`height:${(item.seconds / maxLatestMonthSeconds) * 100}%`}>
                    <div class="training-bar-value">{formatNumber(item.seconds / 3600, 0)}</div>
                    <div class="training-bar-fill"></div>
                  </div>
                </div>
                <span>{item.label}</span>
              </div>
            ))}
          </div>
        </article>

        <article class="panel training-chart-panel training-chart-wide">
          <div class="training-chart-heading"><h3>Träningstid per år</h3><p>Total registrerad träningstid i Attackpoint.</p></div>
          <div class="training-bars training-bars-years">
            {yearly.map((item) => (
              <div class="training-bar-column">
                <div class="training-bar-track">
                  <div class="training-bar-stack" style={`height:${(item.seconds / maxYearSeconds) * 100}%`}>
                    <div class="training-bar-value">{formatNumber(item.seconds / 3600, 0)}</div>
                    <div class="training-bar-fill"></div>
                  </div>
                </div>
                <span>{item.year}</span>
              </div>
            ))}
          </div>
        </article>

        <article class="panel training-chart-panel">
          <div class="training-chart-heading"><h3>Träningsfördelning</h3><p id="activity-subtitle">Andel av träningstiden under {latestYear}.</p></div>
          <div class="training-activity-list" id="activity-chart">
            {latestActivities.slice(0, 10).map((item, index) => (
              <div class="training-activity-row">
                <div class="training-activity-label"><span>{item.activity}</span><strong>{formatHours(item.seconds)}</strong></div>
                <div class="training-activity-track"><div class="training-activity-fill" style={`width:${item.share}%;background:${activityColors[index % activityColors.length]}`}></div></div>
              </div>
            ))}
          </div>
        </article>

        <article class="panel training-chart-panel">
          <div class="training-chart-heading"><h3>Sjukdom, skada & vila</h3><p>Antal markerade dagar per år. Statusarna kan överlappa.</p></div>
          <div class="training-status-legend">
            <span><i class="sick"></i>Sjuk</span>
            <span><i class="injured"></i>Skadad</span>
            <span><i class="rest"></i>Vila</span>
          </div>
          <div class="training-status-chart">
            {statusByYear.map((item) => (
              <div class="training-status-row">
                <span>{item.year}</span>
                <div class="training-status-bars">
                  <i class="sick" style={`width:${(item.sickDays / maxStatusDays) * 100}%`} title={`${item.sickDays} sjukdagar`}></i>
                  <i class="injured" style={`width:${(item.injuredDays / maxStatusDays) * 100}%`} title={`${item.injuredDays} skadedagar`}></i>
                  <i class="rest" style={`width:${(item.restDays / maxStatusDays) * 100}%`} title={`${item.restDays} vilodagar`}></i>
                </div>
              </div>
            ))}
          </div>
        </article>
      </div>
    </section>


    <section class="training-section">
      <div class="training-section-heading">
        <div>
          <p class="eyebrow">TRÄNING × RESULTAT</p>
          <h2>Vad verkar påverka tävlingarna?</h2>
          <p class="training-analysis-intro">Analyserna använder hela perioden och grupperar loppen i stället för att bara visa stora punktmoln. Median används för att minska påverkan från enstaka extremresultat.</p>
        </div>
      </div>

      <div class="training-analysis-grid">
        <article class="panel training-chart-panel">
          <div class="training-chart-heading">
            <h3>Resultat efter träningsmängd</h3>
            <p>Loppen delas i fyra lika stora grupper efter träningstid under de 28 dagarna före tävling. Stapeln visar median resultatpercentil.</p>
          </div>
          <div class="analysis-bars">
            {resultByTrainingQuartile.map((item) => (
              <div class="analysis-bar-item">
                <div class="analysis-bar-chart">
                  <div class="analysis-bar-fill result" style={`height:${item.median}%`}></div>
                  <strong>{formatNumber(item.median, 0)} %</strong>
                </div>
                <span>{item.label}</span>
                <small>{item.inputLabel} · {item.count} lopp</small>
              </div>
            ))}
          </div>
        </article>

        <article class="panel training-chart-panel">
          <div class="training-chart-heading">
            <h3>Resultat efter orienteringsträning</h3>
            <p>Median resultatpercentil beroende på hur mycket orientering som registrerats de senaste 28 dagarna.</p>
          </div>
          <div class="analysis-bars">
            {resultByOrienteeringQuartile.map((item) => (
              <div class="analysis-bar-item">
                <div class="analysis-bar-chart">
                  <div class="analysis-bar-fill orientering" style={`height:${item.median}%`}></div>
                  <strong>{formatNumber(item.median, 0)} %</strong>
                </div>
                <span>{item.label}</span>
                <small>{item.inputLabel} · {item.count} lopp</small>
              </div>
            ))}
          </div>
        </article>

        <article class="panel training-chart-panel">
          <div class="training-chart-heading">
            <h3>Bomandel efter orienteringsträning</h3>
            <p>Median registrerad bomtid som andel av tävlingstiden. Lägre är bättre. Endast lopp med tillförlitligt WinSplits-underlag.</p>
          </div>
          <div class="analysis-bars analysis-bars-inverse">
            {mistakesByOrienteeringQuartile.map((item) => {
              const maxValue = Math.max(1, ...mistakesByOrienteeringQuartile.map((entry) => entry.median));
              return (
                <div class="analysis-bar-item">
                  <div class="analysis-bar-chart">
                    <div class="analysis-bar-fill mistake" style={`height:${(item.median / maxValue) * 100}%`}></div>
                    <strong>{formatNumber(item.median, 1)} %</strong>
                  </div>
                  <span>{item.label}</span>
                  <small>{item.inputLabel} · {item.count} lopp</small>
                </div>
              );
            })}
          </div>
        </article>

        <article class="panel training-chart-panel">
          <div class="training-chart-heading">
            <h3>Tävlingsfart efter löpmängd</h3>
            <p>Median min/km på tävling beroende på antal löpkilometer under de 28 föregående dagarna. Running + Löpning terräng.</p>
          </div>
          <div class="analysis-bars analysis-bars-pace">
            {paceByRunningQuartile.map((item) => {
              const paceValues = paceByRunningQuartile.map((entry) => entry.median);
              const slowest = Math.max(...paceValues);
              const fastest = Math.min(...paceValues);
              const range = Math.max(1, slowest - fastest);
              const score = 35 + ((slowest - item.median) / range) * 65;
              return (
                <div class="analysis-bar-item">
                  <div class="analysis-bar-chart">
                    <div class="analysis-bar-fill sprint" style={`height:${score}%`}></div>
                    <strong>{formatCompactDuration(item.median)}/km</strong>
                  </div>
                  <span>{item.label}</span>
                  <small>{item.inputLabel} · {item.count} lopp</small>
                </div>
              );
            })}
          </div>
        </article>

        <article class="panel training-chart-panel">
          <div class="training-chart-heading">
            <h3>Återhämtning före tävling</h3>
            <p>Median resultatpercentil beroende på antal hela dagar sedan senaste registrerade träningspass.</p>
          </div>
          <div class="analysis-bars">
            {recoveryGroups.map((item) => (
              <div class="analysis-bar-item">
                <div class="analysis-bar-chart">
                  <div class="analysis-bar-fill recovery" style={`height:${item.median}%`}></div>
                  <strong>{formatNumber(item.median, 0)} %</strong>
                </div>
                <span>{item.label}</span>
                <small>{item.count} lopp</small>
              </div>
            ))}
          </div>
        </article>

        <article class="panel training-chart-panel">
          <div class="training-chart-heading">
            <h3>Sjukdom före tävling</h3>
            <p>Median resultatpercentil för lopp med respektive utan sjukmarkering under de föregående 14 dagarna.</p>
          </div>
          <div class="analysis-bars analysis-bars-two">
            {illnessGroups.map((item) => (
              <div class="analysis-bar-item">
                <div class="analysis-bar-chart">
                  <div class="analysis-bar-fill sick-analysis" style={`height:${item.median}%`}></div>
                  <strong>{formatNumber(item.median, 0)} %</strong>
                </div>
                <span>{item.label}</span>
                <small>{item.count} lopp</small>
              </div>
            ))}
          </div>
        </article>

        <article class="panel training-chart-panel">
          <div class="training-chart-heading">
            <h3>Skada före tävling</h3>
            <p>Median resultatpercentil för lopp med respektive utan skademarkering under de föregående 14 dagarna.</p>
          </div>
          <div class="analysis-bars analysis-bars-two">
            {injuryGroups.map((item) => (
              <div class="analysis-bar-item">
                <div class="analysis-bar-chart">
                  <div class="analysis-bar-fill injury-analysis" style={`height:${item.median}%`}></div>
                  <strong>{formatNumber(item.median, 0)} %</strong>
                </div>
                <span>{item.label}</span>
                <small>{item.count} lopp</small>
              </div>
            ))}
          </div>
        </article>

        <article class="panel training-chart-panel training-chart-wide">
          <div class="training-chart-heading">
            <h3>Träningsmängd och resultatnivå per år</h3>
            <p>Orange stapel = total träningstid. Vit punkt = median resultatpercentil för årets tävlingar. Två olika skalor visas tillsammans för att jämföra utvecklingen.</p>
          </div>
          <div class="year-comparison-chart">
            {yearlyRaceTraining.map((item) => (
              <div class="year-comparison-column">
                <div class="year-comparison-plot">
                  <div class="year-training-bar" style={`height:${(item.trainingHours / maxYearTrainingHours) * 100}%`}>
                    <span>{formatNumber(item.trainingHours, 0)} h</span>
                  </div>
                  {Number.isFinite(item.medianResult) && (
                    <div class="year-result-dot" style={`bottom:${item.medianResult}%`} title={`${formatNumber(item.medianResult, 0)} % median · ${item.races} lopp`}>
                      <i></i>
                    </div>
                  )}
                </div>
                <span>{item.year}</span>
              </div>
            ))}
          </div>
          <div class="year-comparison-legend">
            <span><i class="training"></i>Träningstid</span>
            <span><i class="result"></i>Median resultatpercentil</span>
          </div>
        </article>

        <article class="panel training-chart-panel training-chart-wide">
          <div class="training-chart-heading">
            <h3>Senaste kopplade tävlingarna</h3>
            <p>Kontrolltabell för kopplingen mellan Kartarkivet och Attackpoint. ✓ betyder att Attackpoint har ett registrerat pass på samma datum.</p>
          </div>
          <div class="training-race-table-wrap">
            <table class="training-race-table">
              <thead>
                <tr>
                  <th>Tävling</th><th>Datum</th><th>Disciplin</th><th>7 d</th><th>28 d</th><th>Orientering 28 d</th><th>Resultat</th><th>AP</th>
                </tr>
              </thead>
              <tbody>
                {latestLinkedRaces.map((race) => (
                  <tr>
                    <td><a href={race.url}>{race.title}</a></td>
                    <td>{race.date}</td>
                    <td>{race.discipline}</td>
                    <td>{formatNumber(race.trainingHours7, 1)} h</td>
                    <td>{formatNumber(race.trainingHours28, 1)} h</td>
                    <td>{formatNumber(race.orienteeringHours28, 1)} h</td>
                    <td>{formatNumber(race.percentile, 0)} %</td>
                    <td>{race.hasAttackpointSameDay ? '✓' : '—'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </article>
      </div>
    </section>

    <p class="training-update-note">
      Källa: Attackpoint-export. Senaste datum i filen: {trainingRows.at(-1)?.date ?? '—'}.
    </p>
  </main>

  <script define:vars={{ chartData, activityColors }}>
    const select = document.querySelector('#training-year');
    const formatNumber = (value, decimals = 0) =>
      Number(value || 0).toLocaleString('sv-SE', {
        minimumFractionDigits: decimals,
        maximumFractionDigits: decimals
      });
    const formatHours = (seconds) =>
      `${formatNumber(seconds / 3600, seconds >= 360000 ? 0 : 1)} h`;

    const render = (key) => {
      const data = chartData[key];
      if (!data) return;
      const summary = data.summary;

      document.querySelector('#overview-title').textContent = key === 'all' ? 'Alla år' : key;
      document.querySelector('#metric-hours').textContent = formatHours(summary.seconds);
      document.querySelector('#metric-distance').textContent = `${formatNumber(summary.distanceKm, 0)} km`;
      document.querySelector('#metric-climb').textContent = `${formatNumber(summary.climbM, 0)} m`;
      document.querySelector('#metric-orienteering').textContent = formatHours(summary.orienteeringSeconds);
      document.querySelector('#metric-sessions').textContent = formatNumber(summary.sessions);
      document.querySelector('#metric-status').textContent = `${summary.sickDays} / ${summary.injuredDays} d`;

      const monthlyPanel = document.querySelector('#monthly-panel');
      monthlyPanel.hidden = key === 'all';

      if (key !== 'all') {
        document.querySelector('#monthly-subtitle').textContent =
          `Total registrerad träningstid per månad under ${key}.`;
        const max = Math.max(1, ...data.monthly.map((item) => item.seconds));
        document.querySelector('#monthly-chart').innerHTML = data.monthly.map((item) => `
          <div class="training-bar-column">
            <div class="training-bar-track">
              <div class="training-bar-stack" style="height:${(item.seconds / max) * 100}%">
                <div class="training-bar-value">${formatNumber(item.seconds / 3600, 0)}</div>
                <div class="training-bar-fill"></div>
              </div>
            </div>
            <span>${item.label}</span>
          </div>
        `).join('');
      }

      document.querySelector('#activity-subtitle').textContent =
        key === 'all' ? 'Andel av träningstiden för hela perioden.' : `Andel av träningstiden under ${key}.`;
      document.querySelector('#activity-chart').innerHTML = data.activities.slice(0, 10).map((item, index) => `
        <div class="training-activity-row">
          <div class="training-activity-label"><span>${item.activity}</span><strong>${formatHours(item.seconds)}</strong></div>
          <div class="training-activity-track"><div class="training-activity-fill" style="width:${item.share}%;background:${activityColors[index % activityColors.length]}"></div></div>
        </div>
      `).join('');
    };

    select?.addEventListener('change', (event) => render(event.currentTarget.value));
  </script>

