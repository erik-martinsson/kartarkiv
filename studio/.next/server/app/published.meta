{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/published/layout,_N_T_/published/page,_N_T_/published"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/published/__PAGE__",
    "/published",
    "/_index",
    "/_head"
  ]
}